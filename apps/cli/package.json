  "dependencies": {
    "@elvaria/chancellor": "workspace:*",
    "@elvaria/domain": "workspace:*",
    "@elvaria/eventlog": "workspace:*",
    "@elvaria/hooks": "workspace:*",
    "@elvaria/i18n": "workspace:*",
    "@elvaria/registry-default": "workspace:*",
    "@elvaria/runner-antigravity": "workspace:*",
    "@elvaria/runner-claude": "workspace:*",
    "@elvaria/runner-codex": "workspace:*",
    "@elvaria/runner-core": "workspace:*",
    "@elvaria/sandbox": "workspace:*",
    "@elvaria/steward": "workspace:*",
    "@elvaria/store": "workspace:*"
  },
  "devDependencies": {
    "@elvaria/config": "workspace:*",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.1.0",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0"
  }
