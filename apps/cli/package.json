{
  "name": "@elvaria/cli",
  "version": "0.0.0",
  "private": true,
  "description": "The elvaria command: the only composition root. Kingdom, territories, quests, characters, doctor, migrate.",
  "type": "module",
  "bin": {
    "elvaria": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
