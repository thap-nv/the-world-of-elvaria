{
  "version": 1,
  "classes": [
    {
      "id": "scribe",
      "name_vi": "Thư ký",
      "name_en": "Scribe",
      "kinds": ["document"],
      "is_verifier": false,
      "is_monk": false,
      "default_tribe": "gemini",
      "default_model": "gemini-4-argon-medium",
      "tools": {
        "allow": ["Read", "Edit", "Write", "Glob", "Grep"],
        "deny": ["WebFetch", "Bash(git push:*)"]
      },
      "prompt_file": "prompts/scribe.md"
    },
    {
      "id": "judge",
      "name_vi": "Người nghiệm thu",
      "name_en": "Judge",
      "kinds": ["document"],
      "is_verifier": true,
      "is_monk": false,
      "default_tribe": "claude",
      "default_model": "claude-opus-5-5",
      "tools": {
        "allow": ["Read", "Glob", "Grep", "Bash(git diff:*)"],
        "deny": ["Edit", "Write", "Agent"]
      },
      "prompt_file": "prompts/judge.md"
    }
  ]
}
