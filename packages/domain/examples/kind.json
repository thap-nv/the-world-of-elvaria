[
  {
    "version": 1,
    "kinds": [
      {
        "id": "build",
        "name_vi": "Kiến tạo",
        "name_en": "Build",
        "deliverable_type": "branch",
        "ritual": "build_review",
        "checks_default": ["test", "lint", "typecheck", "build"],
        "seal_default": true,
        "classes_allowed": ["knight", "dwarf"]
      },
      {
        "id": "research",
        "name_vi": "Thám hiểm",
        "name_en": "Research",
        "deliverable_type": "report",
        "ritual": "source_check",
        "checks_default": ["links_alive", "citations"],
        "seal_default": false,
        "classes_allowed": ["scout"]
      },
      {
        "id": "fix",
        "name_vi": "Trừ tà",
        "name_en": "Fix",
        "deliverable_type": "branch",
        "ritual": "regression_check",
        "checks_default": ["regression_test", "test"],
        "seal_default": true,
        "classes_allowed": ["knight", "dwarf"]
      },
      {
        "id": "refactor",
        "name_vi": "Gia cố",
        "name_en": "Refactor",
        "deliverable_type": "branch",
        "ritual": "stress_test",
        "checks_default": ["benchmark", "test", "diff_stats"],
        "seal_default": true,
        "classes_allowed": ["knight", "dwarf"]
      },
      {
        "id": "document",
        "name_vi": "Soạn thảo",
        "name_en": "Document",
        "deliverable_type": "file",
        "ritual": "editorial_review",
        "checks_default": ["links_alive", "toc", "terminology"],
        "seal_default": true,
        "classes_allowed": ["scribe"]
      },
      {
        "id": "publish",
        "name_vi": "Rao truyền",
        "name_en": "Publish",
        "deliverable_type": "draft",
        "ritual": "audience_review",
        "checks_default": ["length", "banned_words", "utm_links"],
        "seal_default": true,
        "classes_allowed": ["bard"]
      },
      {
        "id": "analyze",
        "name_vi": "Chiêm nghiệm",
        "name_en": "Analyze",
        "deliverable_type": "report",
        "ritual": "recompute",
        "checks_default": ["rerun_script", "numbers_match"],
        "seal_default": false,
        "classes_allowed": ["astrologer"]
      },
      {
        "id": "plan",
        "name_vi": "Nghị hội",
        "name_en": "Plan",
        "deliverable_type": "subquests",
        "ritual": "council_review",
        "checks_default": ["subquests_complete"],
        "seal_default": false,
        "classes_allowed": ["mage"]
      },
      {
        "id": "integrate",
        "name_vi": "Chinh phục",
        "name_en": "Integrate",
        "deliverable_type": "branch",
        "ritual": "stability_check",
        "checks_default": ["stable_days", "docs_present", "owner_named", "legacy_removed"],
        "seal_default": true,
        "classes_allowed": ["dwarf", "knight"]
      },
      {
        "id": "negotiate",
        "name_vi": "Ngoại giao",
        "name_en": "Negotiate",
        "deliverable_type": "draft",
        "ritual": "sign_off",
        "checks_default": [],
        "seal_default": true,
        "classes_allowed": ["envoy"]
      },
      {
        "id": "batch",
        "name_vi": "Trận đánh",
        "name_en": "Batch",
        "deliverable_type": "report",
        "ritual": "unit_tally",
        "checks_default": ["per_unit"],
        "seal_default": false,
        "classes_allowed": ["knight", "scout", "dwarf"]
      }
    ]
  }
]
