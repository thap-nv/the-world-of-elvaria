{
  "name": "@elvaria/config",
  "version": "0.0.0",
  "private": true,
  "description": "Shared tsconfig, ESLint and Prettier presets, and the dependency table between workspaces.",
  "type": "module",
  "exports": {
    "./boundaries": "./boundaries.mjs",
    "./depcruise": "./depcruise.mjs",
    "./eslint": "./eslint.mjs",
    "./prettier": "./prettier.json",
