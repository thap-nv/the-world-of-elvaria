    "eslint-plugin-unicorn": "^79.0.0",
    "globals": "^17.14.0",
    "typescript-eslint": "^8.72.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.1.0",
    "dependency-cruiser": "^18.7.2",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0"
