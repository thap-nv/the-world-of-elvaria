# lint-staged splits the file list by its unquoted length (8191 on Windows), but cmd.exe gets each
# path quoted and escaped, so a list just under the limit still fails there: split at about half.
pnpm exec lint-staged --max-arg-length 4000
# SEC-04: stop a commit whose staged files hold a secret (the patterns of the pre-push scan); a plain node call.
node scripts/scan-staged-secrets.mjs
