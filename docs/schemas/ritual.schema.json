{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elvaria.dev/schemas/ritual/v1",
  "title": "Registry: verification rituals",
  "description": "registry/rituals.json in the kingdom (copied from @elvaria/registry-default on init). A ritual is how a quest kind is verified: ordered steps, a pass rule and a time limit. Machine checks run before the judge's session; with pass_rule all_checks_and_agent a failing check fails the verdict whatever the judge says. Animation and fantasy names of the ritual live in the theme and i18n. Default registry, one ritual per kind: build_review, source_check, regression_check, stress_test, editorial_review, audience_review, recompute, council_review, stability_check, sign_off, unit_tally.",
  "$comment": "Hand-written v1, the reviewed target; from P0-03 generated by `pnpm schemas` from zod (ADR 0003). Steps are snake_case ids interpreted by runner-core's verifier prompt builder; unknown steps fail registry validation in the loader.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "rituals"],
  "properties": {
    "version": { "const": 1 },
    "rituals": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/ritual" } }
  },
  "$defs": {
    "registry_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "ritual": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name_vi", "name_en", "steps", "pass_rule", "max_seconds"],
      "properties": {
        "id": { "$ref": "#/$defs/registry_id" },
        "name_vi": { "type": "string", "minLength": 1 },
        "name_en": { "type": "string", "minLength": 1 },
        "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/registry_id" } },
        "pass_rule": {
          "enum": ["all_checks_and_agent", "checks_only", "agent_only"],
          "description": "all_checks_and_agent: every check passes and the judge passes; checks_only: machine verdict, no judge session; agent_only: no machine checks apply."
        },
        "max_seconds": { "type": "integer", "minimum": 1 }
      }
    }
  },
  "examples": [
    {
      "version": 1,
      "rituals": [
        { "id": "build_review", "name_vi": "Thợ cả khám công trình", "name_en": "Master builder's inspection", "steps": ["run_checks", "read_handover", "read_diff", "judge", "write_verdict"], "pass_rule": "all_checks_and_agent", "max_seconds": 1800 },
        { "id": "source_check", "name_vi": "Đánh sinh vật canh giữ", "name_en": "Face the guardian", "steps": ["run_checks", "read_handover", "check_sources", "judge", "write_verdict"], "pass_rule": "all_checks_and_agent", "max_seconds": 1800 },
        { "id": "regression_check", "name_vi": "Săn và đặt bẫy", "name_en": "Hunt and set the trap", "steps": ["run_checks", "read_handover", "read_diff", "check_regression_test", "judge", "write_verdict"], "pass_rule": "all_checks_and_agent", "max_seconds": 1800 },
        { "id": "stress_test", "name_vi": "Thử bão", "name_en": "Storm trial", "steps": ["run_checks", "compare_before_after", "read_diff", "judge", "write_verdict"], "pass_rule": "all_checks_and_agent", "max_seconds": 2400 },
        { "id": "editorial_review", "name_vi": "Thủ thư trưởng duyệt bản thảo", "name_en": "Head librarian's review", "steps": ["run_checks", "read_handover", "read_diff", "cross_check_sources", "judge", "write_verdict"], "pass_rule": "all_checks_and_agent", "max_seconds": 1800 },
        { "id": "audience_review", "name_vi": "Dân chúng phản ứng", "name_en": "The crowd responds", "steps": ["run_checks", "read_draft", "score_tone_checklist", "write_verdict"], "pass_rule": "all_checks_and_agent", "max_seconds": 1200 },
        { "id": "recompute", "name_vi": "Chiêm tinh gia thứ hai tính lại", "name_en": "Second astrologer recomputes", "steps": ["run_checks", "rerun_from_source", "compare_numbers", "write_verdict"], "pass_rule": "all_checks_and_agent", "max_seconds": 1800 },
        { "id": "council_review", "name_vi": "Hội đồng biểu quyết", "name_en": "Council vote", "steps": ["run_checks", "read_plan", "challenge_scope", "judge", "write_verdict"], "pass_rule": "all_checks_and_agent", "max_seconds": 1800 },
        { "id": "stability_check", "name_vi": "Lập đồn và cắm cờ", "name_en": "Hold the fort", "steps": ["run_checks", "read_handover", "judge", "write_verdict"], "pass_rule": "all_checks_and_agent", "max_seconds": 1800 },
        { "id": "sign_off", "name_vi": "Ký hiệp ước", "name_en": "Sign the treaty", "steps": ["read_draft", "judge", "write_verdict"], "pass_rule": "agent_only", "max_seconds": 900 },
        { "id": "unit_tally", "name_vi": "Điểm quân sau trận", "name_en": "Muster after battle", "steps": ["run_checks", "tally_units", "write_verdict"], "pass_rule": "checks_only", "max_seconds": 600 }
      ]
    }
  ]
}
