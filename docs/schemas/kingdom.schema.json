{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elvaria.dev/schemas/kingdom/v1",
  "title": "Kingdom",
  "description": "kingdom.json at the root of a kingdom directory (one machine, one user, one kingdom). The kingdom directory is chosen with `elvaria init --kingdom <dir>` and lives outside the Elvaria repo. Holds the owner's settings: tribes (one per signed-in account, each run by an adapter), mana cap and king's reserve, circuit breakers, schedules, dispatch policy, bell channels, tunnel, theme and UI mode. `elvaria doctor` fills `tribes[].tool`.",
  "$comment": "Hand-written v1, the reviewed target. From P0-03 this file is generated by `pnpm schemas` from the zod source in packages/domain/src/schema (ADR 0003) and CI drift-checks docs/schemas. Paths inside kingdom files are relative to the kingdom directory with '/' separators; the only absolute paths are territory.path and paths.treasury (implementation-plan §2.1).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "name",
    "created_at",
    "tz",
    "owner",
    "paths",
    "tribes",
    "mana",
    "breakers",
    "schedule",
    "dispatch",
    "bell",
    "tunnel",
    "theme",
    "ui"
  ],
  "properties": {
    "version": { "const": 1 },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 24,
      "description": "Kingdom name chosen by the owner; rendered with `.elv-name` (24ch)."
    },
    "created_at": { "type": "string", "format": "date-time" },
    "tz": {
      "type": "string",
      "pattern": "^[A-Za-z]+(?:/[A-Za-z0-9_+-]+)*$",
      "description": "IANA time zone of the machine (e.g. Asia/Ho_Chi_Minh). Event files are named by local day; recording tz keeps replays consistent."
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profession"],
      "properties": {
        "profession": { "enum": ["developer", "ba", "marketing", "researcher", "other"] },
        "locale": {
          "enum": ["vi", "en"],
          "default": "vi",
          "description": "Language of everything the owner reads: handover letters, verdict notes, blocked questions, chronicle, bell, UI."
        }
      }
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["treasury"],
      "properties": {
        "treasury": {
          "$ref": "#/$defs/abs_path",
          "description": "Treasury file (secrets), always outside the kingdom, e.g. ~/.elvaria/treasury.json resolved to an absolute path."
        }
      }
    },
    "tribes": {
      "type": "array",
      "minItems": 1,
      "description": "Tribes (product plan 0.6, tribe contract): one entry per account the owner signs in to on this machine. Adding a tribe = an adapter (built in, or a file adapters/<name>.mjs in the kingdom) + a theme entry (name, mana colour, sprites, crest) + the owner's own login; the core and existing characters do not change. `elvaria init` writes claude (claude_code) and gemini (antigravity). The Steward reads each adapter's capabilities at start and narrows what that tribe may take (implementation-plan §3.14). Ids are unique (zod).",
      "items": { "$ref": "#/$defs/tribe" }
    },
    "mana": {
      "type": "object",
      "additionalProperties": false,
      "$comment": "Intake threshold per pool = min(cap_pct, 100 - king_reserve_pct). The world never takes new quests at or above it; a warning fires warn_margin_pct points earlier.",
      "properties": {
        "cap_pct": { "type": "number", "minimum": 1, "maximum": 100, "default": 98 },
        "king_reserve_pct": { "type": "number", "minimum": 0, "maximum": 50, "default": 2 },
        "warn_margin_pct": { "type": "number", "minimum": 0, "maximum": 50, "default": 10 },
        "probe_interval_minutes": { "type": "integer", "minimum": 1, "maximum": 1440, "default": 15 },
        "reassign_after_hours": {
          "type": ["integer", "null"],
          "minimum": 1,
          "default": null,
          "description": "If set, a quest in paused_mana longer than this may be reassigned to another character by rule. null = never (principle 6 keeps the assignee)."
        }
      }
    },
    "breakers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "attempt_minutes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "low": { "type": "integer", "minimum": 1, "default": 45, "description": "Ranks below high_rank_from." },
            "high": { "type": "integer", "minimum": 1, "default": 120, "description": "Ranks from high_rank_from up, and territories with an exclusive e2e check." }
          }
        },
        "high_rank_from": { "$ref": "#/$defs/rank", "default": "B" },
        "max_attempts": { "type": "integer", "minimum": 1, "default": 3 },
        "mana_multiplier": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 2,
          "description": "quest.budget.max_tokens = estimate.tokens x mana_multiplier."
        },
        "same_fail_suspend": { "type": "integer", "minimum": 1, "default": 3 },
        "patrol_weekly_pct": { "type": "number", "minimum": 0, "maximum": 100, "default": 10 },
        "max_turns": { "type": "integer", "minimum": 1, "default": 200 },
        "subagent_max_minutes": {
          "type": "integer",
          "minimum": 1,
          "default": 5,
          "description": "Measured only (hook SubagentStart/Stop); overrun emits agent.subagent.overrun and counts against the parent quest."
        },
        "subagent_max_turns": {
          "type": "integer",
          "minimum": 1,
          "default": 30,
          "description": "The enforceable apprentice breaker: maxTurns of the `apprentice` agent definition."
        },
        "context_budget_tokens": {
          "type": "integer",
          "minimum": 1,
          "default": 120000,
          "description": "The Chancellor splits work so one quest fits one context (principle 13)."
        }
      }
    },
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "$comment": "Scheduled jobs run inside the Steward (no cron, Task Scheduler or launchd). The job list is empty in stage 1, so every job defaults to disabled.",
      "properties": {
        "chronicle": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean", "default": false },
            "at": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$", "default": "21:00" }
          }
        },
        "temple": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean", "default": false },
            "every_quests": { "type": "integer", "minimum": 1, "default": 10 },
            "weekly": { "type": "boolean", "default": true }
          }
        },
        "patrol": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean", "default": false },
            "every": {
              "type": "string",
              "pattern": "^P(?:[0-9]+D)?(?:T(?:[0-9]+H)?(?:[0-9]+M)?)?$",
              "default": "P1D",
              "description": "ISO-8601 duration."
            }
          }
        }
      }
    },
    "dispatch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tick_seconds": { "type": "integer", "minimum": 1, "default": 5 },
        "fairness": { "enum": ["round_robin_territory"], "default": "round_robin_territory" },
        "verifier_same_family": {
          "enum": ["different_model", "machine_only"],
          "default": "different_model",
          "description": "When no verifier of another model family is free: different_model requires a different model slug; machine_only lets the Steward issue a machine verdict (never pass with a failing check)."
        },
        "resume_after_mana": {
          "type": "boolean",
          "default": false,
          "description": "Revive with `--resume <session>` instead of a fresh session built from handover.md. Off by default (principle 13, ADR 0017)."
        }
      }
    },
    "bell": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "desktop": { "type": "boolean", "default": true },
        "web_push": { "type": "boolean", "default": false },
        "messaging": {
          "type": "null",
          "default": null,
          "description": "Messaging channel, chosen in stage 2; null until then."
        }
      }
    },
    "tunnel": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "kind": { "enum": ["tailscale", "cloudflare"] }
      }
    },
    "theme": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$", "default": "fantasy" },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": { "enum": ["night", "day"], "default": "night" },
        "eco": { "type": "boolean", "default": false }
      }
    }
  },
  "$defs": {
    "abs_path": {
      "type": "string",
      "pattern": "^(?:[A-Za-z]:/|/)[^\\\\]*$",
      "description": "Absolute path with '/' separators (Windows drive or POSIX root); no backslashes in data files."
    },
    "model_slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$" },
    "rank": { "enum": ["F", "E", "D", "C", "B", "A", "S"] },
    "tribe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "adapter", "enabled", "max_concurrent"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "TribeId, referenced by character.tribe and class.default_tribe. Display name, mana colour and crest are theme data keyed by this id."
        },
        "adapter": {
          "type": "string",
          "pattern": "^(?:[a-z][a-z0-9_]*|adapters/[a-z0-9][a-z0-9-]*\\.mjs)$",
          "description": "A built-in adapter (claude_code, antigravity, gemini_cli, codex_cli) or an adapter file adapters/<name>.mjs inside the kingdom that exports createAdapter(kit) and passes the conformance suite."
        },
        "enabled": { "type": "boolean", "default": true },
        "max_concurrent": { "type": "integer", "minimum": 1, "default": 1 },
        "tool": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "version"],
          "description": "The CLI binary, filled and pinned by `elvaria doctor`. Doctor warns when the installed version differs and refuses adapter = antigravity without terms_acknowledged_at.",
          "properties": {
            "path": { "$ref": "#/$defs/abs_path" },
            "version": { "type": "string", "minLength": 1 },
            "default_model": { "$ref": "#/$defs/model_slug" },
            "auth": {
              "enum": ["login", "api_key"],
              "default": "login",
              "description": "login = the owner's own sign-in saved by the unmodified CLI (claude.ai, Google, ChatGPT); api_key = a key from the treasury (paid, so budget.usd_week is required; mandatory for Claude if Elvaria is shared with other people)."
            },
            "terms_acknowledged_at": {
              "type": "string",
              "format": "date-time",
              "description": "When the owner acknowledged the provider's terms for wrapping its CLI (Antigravity: not supported on consumer plans, ADR 0018)."
            }
          }
        },
        "pools": {
          "type": "object",
          "description": "Adapters with several mana pools in one account (antigravity: gemini_models on, claude_gpt_models off by default so the Gemini tribe really is the Gemini model family). Tribe state is computed per pool.",
          "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["enabled"],
            "properties": { "enabled": { "type": "boolean" } }
          }
        },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "description": "Denominator for the `estimate` gauge source (implementation-plan §3.5).",
          "properties": {
            "tokens_5h": { "type": "integer", "minimum": 1 },
            "tokens_7d": { "type": "integer", "minimum": 1 },
            "usd_week": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Weekly spend ceiling; required when tool.auth = api_key (a paid key has no hard cap of its own)."
            }
          }
        }
      },
      "allOf": [
        {
          "$comment": "Gemini CLI no longer serves consumer accounts: it runs only with a paid API key.",
          "if": { "properties": { "adapter": { "const": "gemini_cli" } } },
          "then": { "properties": { "tool": { "required": ["auth"], "properties": { "auth": { "const": "api_key" } } } } }
        },
        {
          "if": { "required": ["tool"], "properties": { "tool": { "required": ["auth"], "properties": { "auth": { "const": "api_key" } } } } },
          "then": { "required": ["budget"], "properties": { "budget": { "required": ["usd_week"] } } }
        }
      ]
    }
  },
  "examples": [
    {
      "version": 1,
      "name": "Vương quốc Bình Minh",
      "created_at": "2026-11-06T09:00:00+07:00",
      "tz": "Asia/Ho_Chi_Minh",
      "owner": { "profession": "developer", "locale": "vi" },
      "paths": { "treasury": "C:/Users/thapn/.elvaria/treasury.json" },
      "tribes": [
        {
          "id": "claude",
          "adapter": "claude_code",
          "enabled": true,
          "max_concurrent": 2,
          "tool": {
            "path": "C:/Users/thapn/.vscode/extensions/anthropic.claude-code-2.1.318-win32-x64/resources/native-binary/claude.exe",
            "version": "2.1.318",
            "default_model": "claude-sonnet-5-5",
            "auth": "login"
          },
          "budget": { "tokens_5h": 4000000, "tokens_7d": 60000000 }
        },
        {
          "id": "gemini",
          "adapter": "antigravity",
          "enabled": true,
          "max_concurrent": 1,
          "tool": {
            "path": "C:/Users/thapn/.gemini/bin/agy.exe",
            "version": "1.5.1",
            "default_model": "gemini-4-argon-medium",
            "auth": "login",
            "terms_acknowledged_at": "2026-11-06T13:10:00+07:00"
          },
          "pools": { "gemini_models": { "enabled": true }, "claude_gpt_models": { "enabled": false } }
        },
        { "id": "codex", "adapter": "codex_cli", "enabled": false, "max_concurrent": 1 }
      ],
      "mana": {
        "cap_pct": 98,
        "king_reserve_pct": 2,
        "warn_margin_pct": 10,
        "probe_interval_minutes": 15,
        "reassign_after_hours": null
      },
      "breakers": {
        "attempt_minutes": { "low": 45, "high": 120 },
        "high_rank_from": "B",
        "max_attempts": 3,
        "mana_multiplier": 2,
        "same_fail_suspend": 3,
        "patrol_weekly_pct": 10,
        "max_turns": 200,
        "subagent_max_minutes": 5,
        "subagent_max_turns": 30,
        "context_budget_tokens": 120000
      },
      "schedule": {
        "chronicle": { "enabled": false, "at": "21:00" },
        "temple": { "enabled": false, "every_quests": 10, "weekly": true },
        "patrol": { "enabled": false, "every": "P1D" }
      },
      "dispatch": {
        "tick_seconds": 5,
        "fairness": "round_robin_territory",
        "verifier_same_family": "different_model",
        "resume_after_mana": false
      },
      "bell": { "desktop": true, "web_push": false, "messaging": null },
      "tunnel": { "enabled": false },
      "theme": "fantasy",
      "ui": { "mode": "night", "eco": false }
    }
  ]
}
