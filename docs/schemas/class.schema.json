{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elvaria.dev/schemas/class/v1",
  "title": "Registry: character classes",
  "description": "registry/classes.json in the kingdom (copied from @elvaria/registry-default on init). A class = role prompt + kinds it takes + tool policy + default model and tribe. One class per character (principle 5). There is one verifier class, `judge`, whose ritual follows the quest kind; the per-kind titles (Thợ cả, Thủ thư trưởng, ...) are theme data (ADR 0011). Default registry: chancellor, mage, knight, dwarf, scout, scribe, bard, astrologer, envoy, judge, monk (11 classes; the design has 12 class icons because judge has two).",
  "$comment": "Generated by `pnpm schemas` from the zod source in packages/domain/src/schema (ADR 0003): change the zod source, never this file. Tool names use Claude Code syntax; runner-antigravity and runner-gemini translate them into their own policy format. ToolPolicy = class tools + territory laws + role (a verifier never gets Edit/Write). The registry loader (parseRegistry) checks: not both is_verifier and is_monk; kinds exist in kinds.json and, for a class that is not a verifier, allow it back. prompt_file is checked by the store when it loads a kingdom.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "classes"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "classes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/class"
      }
    }
  },
  "$defs": {
    "class": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name_vi",
        "name_en",
        "kinds",
        "is_verifier",
        "is_monk",
        "default_tribe",
        "default_model",
        "tools",
        "prompt_file"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "name_vi": {
          "type": "string",
          "minLength": 1
        },
        "name_en": {
          "type": "string",
          "minLength": 1
        },
        "kinds": {
          "description": "Kinds this class works on; for a verifier class, the kinds it may judge. Empty for chancellor and monk.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        },
        "is_verifier": {
          "type": "boolean"
        },
        "is_monk": {
          "type": "boolean"
        },
        "default_tribe": {
          "description": "Tribe suggested for new characters of this class; any tribe in kingdom.tribes may be chosen at summon time.",
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "default_model": {
          "$ref": "#/$defs/model_slug"
        },
        "tools": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "allow",
            "deny"
          ],
          "properties": {
            "allow": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "deny": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "prompt_file": {
          "description": "Role prompt, relative to registry/.",
          "type": "string",
          "pattern": "^prompts/[a-z][a-z0-9_-]*\\.md$"
        }
      }
    },
    "model_slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]*$"
    }
  },
  "examples": [
    {
      "version": 1,
      "classes": [
        {
          "id": "chancellor",
          "name_vi": "Tể tướng",
          "name_en": "Chancellor",
          "kinds": [],
          "is_verifier": false,
          "is_monk": false,
          "default_tribe": "claude",
          "default_model": "claude-sonnet-5-5",
          "tools": {
            "allow": [],
            "deny": []
          },
          "prompt_file": "prompts/chancellor.md"
        },
        {
          "id": "knight",
          "name_vi": "Hiệp sĩ",
          "name_en": "Knight",
          "kinds": [
            "build",
            "fix",
            "refactor",
            "integrate",
            "batch"
          ],
          "is_verifier": false,
          "is_monk": false,
          "default_tribe": "claude",
          "default_model": "claude-sonnet-5-5",
          "tools": {
            "allow": [
              "Read",
              "Edit",
              "Write",
              "Glob",
              "Grep",
              "Bash(pnpm test:*)",
              "Bash(pnpm lint:*)",
              "Bash(pnpm typecheck:*)",
              "Bash(git status:*)",
              "Bash(git diff:*)",
              "Bash(git add:*)",
              "Bash(git commit:*)",
              "Agent(apprentice)"
            ],
            "deny": [
              "Bash(git push:*)",
              "WebFetch"
            ]
          },
          "prompt_file": "prompts/knight.md"
        },
        {
          "id": "scout",
          "name_vi": "Elf trinh sát",
          "name_en": "Scout",
          "kinds": [
            "research",
            "batch"
          ],
          "is_verifier": false,
          "is_monk": false,
          "default_tribe": "gemini",
          "default_model": "gemini-4-argon-medium",
          "tools": {
            "allow": [
              "Read",
              "Edit",
              "Write",
              "Glob",
              "Grep",
              "WebFetch",
              "WebSearch"
            ],
            "deny": [
              "Bash(git push:*)"
            ]
          },
          "prompt_file": "prompts/scout.md"
        },
        {
          "id": "scribe",
          "name_vi": "Thư ký",
          "name_en": "Scribe",
          "kinds": [
            "document"
          ],
          "is_verifier": false,
          "is_monk": false,
          "default_tribe": "gemini",
          "default_model": "gemini-4-argon-medium",
          "tools": {
            "allow": [
              "Read",
              "Edit",
              "Write",
              "Glob",
              "Grep"
            ],
            "deny": [
              "WebFetch",
              "Bash(git push:*)"
            ]
          },
          "prompt_file": "prompts/scribe.md"
        },
        {
          "id": "judge",
          "name_vi": "Người nghiệm thu",
          "name_en": "Judge",
          "kinds": [
            "build",
            "research",
            "fix",
            "refactor",
            "document",
            "publish",
            "analyze",
            "plan",
            "integrate",
            "negotiate",
            "batch"
          ],
          "is_verifier": true,
          "is_monk": false,
          "default_tribe": "claude",
          "default_model": "claude-opus-5-5",
          "tools": {
            "allow": [
              "Read",
              "Glob",
              "Grep",
              "Bash(pnpm test:*)",
              "Bash(pnpm lint:*)",
              "Bash(pnpm typecheck:*)",
              "Bash(git diff:*)"
            ],
            "deny": [
              "Edit",
              "Write",
              "Agent"
            ]
          },
          "prompt_file": "prompts/judge.md"
        },
        {
          "id": "monk",
          "name_vi": "Thầy tu",
          "name_en": "Monk",
          "kinds": [],
          "is_verifier": false,
          "is_monk": true,
          "default_tribe": "gemini",
          "default_model": "gemini-3.8-flash-low",
          "tools": {
            "allow": [
              "Read",
              "Glob",
              "Grep"
            ],
            "deny": [
              "Edit",
              "Write",
              "Bash"
            ]
          },
          "prompt_file": "prompts/monk.md"
        }
      ]
    }
  ]
}
