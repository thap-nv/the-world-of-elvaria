{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elvaria.dev/schemas/tribe-looks/v1",
  "title": "Tribe look pool",
  "description": "A theme's pool of tribe looks (PS-24; implementation-plan §2.7, §3.14): the parts a look is made of, and the looks the theme pins to tribe ids. A tribe looks as the owner chose (kingdom.tribes[].look), else as pinned, else as tribeLookOf draws it: the same parts for the same id on every run, in the order of kingdom.tribes[], skipping the palettes and crests other tribes hold, so any two tribes differ in both while the pool lasts. Part names are display strings (i18n `tribe_look.<part>.<id>`).",
  "$comment": "Generated by `pnpm schemas` from the zod source in packages/domain/src/schema (ADR 0003): change the zod source, never this file. The domain's spec holds every palette of the default pool to the design system's tokens: contrast on the night and day backgrounds, and distance from the quest status colours and from each other.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "theme",
    "palettes",
    "crests",
    "figures",
    "auras",
    "frames",
    "pinned"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "theme": {
      "description": "The theme this pool belongs to, as kingdom.theme names it.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "palettes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "night",
          "day"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9](?:[a-z0-9-]{0,30}[a-z0-9])?$"
          },
          "night": {
            "description": "The colour on the night theme: light, on the dark background.",
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          },
          "day": {
            "description": "The colour on the day theme: dark, on the parchment background.",
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          }
        }
      }
    },
    "crests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9](?:[a-z0-9-]{0,30}[a-z0-9])?$"
          }
        }
      }
    },
    "figures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9](?:[a-z0-9-]{0,30}[a-z0-9])?$"
          }
        }
      }
    },
    "auras": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9](?:[a-z0-9-]{0,30}[a-z0-9])?$"
          }
        }
      }
    },
    "frames": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9](?:[a-z0-9-]{0,30}[a-z0-9])?$"
          }
        }
      }
    },
    "pinned": {
      "description": "The theme's own look for a tribe id it knows (fantasy: claude the Silver Star, gemini the Red Fire). Their palettes and crests are never drawn for another tribe, so adding one of these tribes later changes no look.",
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "palette",
          "crest",
          "figure",
          "aura",
          "frame"
        ],
        "properties": {
          "palette": {
            "description": "Palette: the colour of the crest, the mana bar and the tint of the models.",
            "type": "string",
            "pattern": "^[a-z0-9](?:[a-z0-9-]{0,30}[a-z0-9])?$"
          },
          "crest": {
            "description": "Crest: the icon on the banner, the portrait and the mana bar (`crest-<id>`).",
            "type": "string",
            "pattern": "^[a-z0-9](?:[a-z0-9-]{0,30}[a-z0-9])?$"
          },
          "figure": {
            "description": "Figure: the body the characters of the tribe are built on; the class dresses it.",
            "type": "string",
            "pattern": "^[a-z0-9](?:[a-z0-9-]{0,30}[a-z0-9])?$"
          },
          "aura": {
            "description": "Aura: how the tribe's mana shows around its characters.",
            "type": "string",
            "pattern": "^[a-z0-9](?:[a-z0-9-]{0,30}[a-z0-9])?$"
          },
          "frame": {
            "description": "Portrait frame: the shape around a character of the tribe on the 2D screens.",
            "type": "string",
            "pattern": "^[a-z0-9](?:[a-z0-9-]{0,30}[a-z0-9])?$"
          }
        }
      }
    }
  },
  "examples": [
    {
      "version": 1,
      "theme": "harbour",
      "palettes": [
        {
          "id": "silver",
          "night": "#8AD8D4",
          "day": "#176E6A"
        },
        {
          "id": "red",
          "night": "#FF8A60",
          "day": "#AE3814"
        },
        {
          "id": "yellow",
          "night": "#F3E25B",
          "day": "#6C5F15"
        }
      ],
      "crests": [
        {
          "id": "anchor"
        },
        {
          "id": "gull"
        },
        {
          "id": "lighthouse"
        }
      ],
      "figures": [
        {
          "id": "slender"
        },
        {
          "id": "sturdy"
        }
      ],
      "auras": [
        {
          "id": "glow"
        }
      ],
      "frames": [
        {
          "id": "round"
        },
        {
          "id": "porthole"
        }
      ],
      "pinned": {
        "claude": {
          "palette": "silver",
          "crest": "anchor",
          "figure": "slender",
          "aura": "glow",
          "frame": "round"
        }
      }
    }
  ]
}
