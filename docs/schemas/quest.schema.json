    {
      "version": 1,
      "id": "q_20261106_9p4r8d",
      "title": "Kiểm tra link nội bộ",
      "description": "Kiểm tra mọi link nội bộ trong README.md, docs/**/*.md và CLAUDE.md; mỗi link là một đơn vị, link chết mở quest con.",
      "kind": "batch",
      "rank": "E",
      "tags": [
        "docs"
      ],
      "territory": "dc1-se-team",
      "status": "done",
      "tier": "script",
      "script": {
        "id": "link-check",
        "params": {
          "globs": [
            "README.md",
            "docs/**/*.md",
            "CLAUDE.md"
          ]
        }
      },
      "assignee": null,
      "verifier": null,
      "depends_on": [],
      "budget": {
        "max_minutes": 10,
        "max_tokens": 0,
        "max_attempts": 1
      },
      "estimate": {
        "tokens": 0,
        "minutes": 2
      },
      "attempts": 1,
      "attempt_log": [
        {
          "n": 1,
          "character": null,
          "role": "assignee",
          "started_at": "2026-11-06T10:00:00+07:00",
