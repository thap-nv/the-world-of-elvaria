{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elvaria.dev/schemas/quest/v1",
  "title": "Quest",
  "description": "quests/<id>.json: one unit of real work on a territory. Only the Steward writes this file (ADR 0005); the CLI, Herald and phone write commands to inbox/. The quest folder quests/<id>/ holds handover.md (written by the character) and journal.jsonl (written by hooks); there is no `journal` path field because the location is a convention.",
  "$comment": "Hand-written v1, the reviewed target; from P0-03 generated by `pnpm schemas` from zod (ADR 0003). Invariants JSON Schema cannot express are zod refines in packages/domain: verifier != assignee; the verifier never appears in attempt_log with role assignee for this quest; secrets_required is a subset of territory.secrets_allowed; kind, class_required and tags are validated against the registry, and class_required is in kinds[kind].classes_allowed; party_role = contract implies party_id = id; no character who worked on any quest of a party (same party_id) verifies a quest of that party; status changes only through the transition table (domain/src/quest/transitions.ts).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "id",
    "title",
    "description",
    "kind",
    "rank",
    "territory",
    "tags",
    "status",
    "tier",
    "budget",
    "estimate",
    "attempts",
    "attempt_log",
    "plot",
    "deliverable",
    "seal_required",
    "created_by",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "version": { "const": 1 },
    "id": { "$ref": "#/$defs/quest_id" },
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "description": { "type": "string", "minLength": 1 },
    "kind": { "$ref": "#/$defs/registry_id", "description": "KindId, validated against registry/kinds.json (11 default kinds)." },
    "rank": { "$ref": "#/$defs/rank" },
    "class_required": {
      "$ref": "#/$defs/registry_id",
      "description": "ClassId the assignee must have (product plan 0.5 §4); must be one of kinds[kind].classes_allowed. Required when tier = session."
    },
    "tags": {
      "type": "array",
      "items": { "$ref": "#/$defs/tag_id" },
      "uniqueItems": true,
      "maxItems": 6,
      "default": [],
      "description": "Expertise tags from registry/tags.json, set by the Chancellor. Candidates of class_required are ranked by their reputation on these tags (character.skill_affinity), and up to 3 skills matching these tags and the territory are loaded into the prompt. A party part has one main tag."
    },
    "party_id": {
      "$ref": "#/$defs/quest_id",
      "description": "Party (đội) this quest belongs to: the id of the party's contract quest (kind plan, written by the party lead)."
    },
    "party_role": {
      "enum": ["contract", "part", "merge"],
      "description": "contract = the plan quest whose lead writes the contract and the parts; part = one area, one main tag, one character, one worktree, one verdict; merge = the final quest that merges the part branches and runs the full checks. The party is done when its merge quest is done."
    },
    "contract": {
      "type": "string",
      "minLength": 1,
      "description": "Path of the contract inside the territory, e.g. apps/api/openapi.json, committed on the contract quest's branch. Parts and the merge quest branch from that branch, so they all see the same contract."
    },
    "territory": { "$ref": "#/$defs/slug" },
    "status": {
      "enum": ["draft", "open", "claimed", "working", "review", "returned", "awaiting_seal", "done", "blocked", "paused_mana", "infirmary", "archived"]
    },
    "tier": {
      "enum": ["script", "session"],
      "default": "session",
      "description": "Execution tier (ADR 0017). An apprentice (sub-agent) is not a quest tier: it happens inside a session."
    },
    "script": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "description": "Required when tier = script; id from registry/scripts.json. No model call, mana 0.",
      "properties": {
        "id": { "$ref": "#/$defs/script_id" },
        "params": { "type": "object", "default": {}, "description": "Validated against the script's params_schema." }
      }
    },
    "assignee": { "$ref": "#/$defs/slug_or_null" },
    "verifier": { "$ref": "#/$defs/slug_or_null" },
    "campaign_id": { "type": ["string", "null"], "pattern": "^c_[0-9]{8}_[0-9a-hjkmnp-tv-z]{6}$" },
    "parent_id": { "type": ["string", "null"], "pattern": "^q_[0-9]{8}_[0-9a-hjkmnp-tv-z]{6}$" },
    "depends_on": {
      "type": "array",
      "items": { "$ref": "#/$defs/quest_id" },
      "uniqueItems": true,
      "default": [],
      "description": "Unfinished dependencies keep the quest blocked."
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_minutes", "max_tokens", "max_attempts"],
      "description": "Derived from kingdom.breakers and rank; the owner may edit it.",
      "properties": {
        "max_minutes": { "type": "integer", "minimum": 1 },
        "max_tokens": { "type": "integer", "minimum": 0 },
        "max_attempts": { "type": "integer", "minimum": 1 }
      }
    },
    "estimate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tokens", "minutes"],
      "description": "The Chancellor's estimate.",
      "properties": {
        "tokens": { "type": "integer", "minimum": 0 },
        "minutes": { "type": "integer", "minimum": 0 }
      }
    },
    "attempts": { "type": "integer", "minimum": 0, "default": 0 },
    "attempt_log": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["n", "character", "role", "started_at", "run_dir"],
        "properties": {
          "n": { "type": "integer", "minimum": 1 },
          "character": {
            "$ref": "#/$defs/slug_or_null",
            "description": "null for script-tier runs (the Steward runs the script)."
          },
          "role": { "enum": ["assignee", "verifier"] },
          "started_at": { "type": "string", "format": "date-time" },
          "ended_at": { "type": "string", "format": "date-time" },
          "outcome": {
            "enum": ["submitted", "returned", "timeout", "breaker", "crash", "paused", "blocked", "cancelled"],
            "description": "timeout = the time breaker tripped; breaker = the token or turn breaker tripped."
          },
          "session_id": { "type": "string", "minLength": 1 },
          "tokens": { "type": "integer", "minimum": 0 },
          "run_dir": { "type": "string", "pattern": "^\\.runs/[^\\\\]+$", "description": "Relative to the kingdom: .runs/<quest>-<n> (verifier: .runs/<quest>-<n>/verify)." }
        }
      }
    },
    "plot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "description": "The quest's own ground. worktree: absolute path <territory.path>/<worktree_dir>/<id> on branch quest/<id>; folder: quests/<id>/work (only for non-git territories).",
      "properties": {
        "type": { "enum": ["worktree", "folder", "none"] },
        "path": { "type": "string", "minLength": 1 },
        "branch": { "type": "string", "pattern": "^quest/q_[0-9]{8}_[0-9a-hjkmnp-tv-z]{6}$" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "worktree" } } },
          "then": { "required": ["path", "branch"] }
        },
        {
          "if": { "properties": { "type": { "const": "folder" } } },
          "then": { "required": ["path"] }
        }
      ]
    },
    "deliverable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "description": "Delivery follows the kind's convention; delivered_at marks done-and-delivered (not a separate status).",
      "properties": {
        "type": { "enum": ["branch", "file", "report", "draft", "subquests", "none"] },
        "path": { "type": "string", "minLength": 1 },
        "branch": { "type": "string", "minLength": 1 },
        "delivered_at": { "type": "string", "format": "date-time" }
      }
    },
    "seal_required": { "type": "boolean", "default": false },
    "seal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["at"],
      "properties": {
        "at": { "type": "string", "format": "date-time" },
        "note": { "type": "string" }
      }
    },
    "blocked": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question", "asked_at"],
      "properties": {
        "question": { "type": "string", "minLength": 1 },
        "asked_at": { "type": "string", "format": "date-time" },
        "answer": { "type": "string" },
        "answered_at": { "type": "string", "format": "date-time" }
      }
    },
    "secrets_required": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
      "uniqueItems": true,
      "default": []
    },
    "checks_run": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
      "default": [],
      "description": "Territory check ids selected after the work, from the paths actually touched."
    },
    "units": {
      "type": "array",
      "description": "Batch quests: units produced by a script with produces = units. Units that need judgement become child session quests, not apprentices.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "outcome"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$" },
          "label": { "type": "string", "minLength": 1 },
          "outcome": {
            "enum": ["pending", "done", "not_done", "needs_user", "debt"],
            "description": "Muster after battle: done = kill, not_done = grave, needs_user = wounded, debt = ruin."
          },
          "child_quest": { "$ref": "#/$defs/quest_id" }
        }
      }
    },
    "created_by": { "enum": ["chancellor", "user", "council", "patrol", "battle", "campaign"] },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "$comment": "Script tier: a catalog script, no character.",
      "if": { "properties": { "tier": { "const": "script" } } },
      "then": { "required": ["script"], "properties": { "assignee": { "type": "null" } } }
    },
    {
      "$comment": "Session tier: a character holds the quest while it is in flight.",
      "if": {
        "properties": {
          "tier": { "const": "session" },
          "status": { "enum": ["claimed", "working", "review", "returned", "awaiting_seal", "paused_mana"] }
        }
      },
      "then": { "required": ["assignee"], "properties": { "assignee": { "type": "string" } } }
    },
    {
      "if": { "properties": { "status": { "const": "review" } } },
      "then": { "properties": { "attempts": { "minimum": 1 } } }
    },
    {
      "if": { "required": ["seal"] },
      "then": { "properties": { "status": { "enum": ["done", "archived"] } } }
    },
    {
      "if": { "properties": { "status": { "const": "blocked" } } },
      "then": { "required": ["blocked"] }
    },
    {
      "$comment": "Session tier: the class is fixed when the quest is created.",
      "if": { "properties": { "tier": { "const": "session" } } },
      "then": { "required": ["class_required"] }
    },
    {
      "$comment": "Party fields come together: a member has a role; parts and the merge quest know the contract.",
      "if": { "required": ["party_id"] },
      "then": { "required": ["party_role"] }
    },
    {
      "if": { "required": ["party_role"] },
      "then": { "required": ["party_id"] }
    },
    {
      "if": { "required": ["party_role"], "properties": { "party_role": { "enum": ["part", "merge"] } } },
      "then": { "required": ["contract"] }
    }
  ],
  "$defs": {
    "tag_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "quest_id": { "type": "string", "pattern": "^q_[0-9]{8}_[0-9a-hjkmnp-tv-z]{6}$" },
    "slug": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,30}[a-z0-9])?$" },
    "slug_or_null": { "type": ["string", "null"], "pattern": "^[a-z0-9](?:[a-z0-9-]{0,30}[a-z0-9])?$" },
    "registry_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "script_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "rank": { "enum": ["F", "E", "D", "C", "B", "A", "S"] }
  },
  "examples": [
