{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elvaria.dev/schemas/quest/v1",
  "title": "Quest",
  "description": "quests/<id>.json: one unit of real work on a territory. Only the Steward writes this file (ADR 0005); the CLI, Herald and phone write commands to inbox/. The quest folder quests/<id>/ holds handover.md (written by the character) and journal.jsonl (written by hooks); there is no `journal` path field because the location is a convention.",
  "$comment": "Generated by `pnpm schemas` from the zod source in packages/domain/src/schema (ADR 0003): change the zod source, never this file. Not expressible here, checked by zod: verifier != assignee; the verifier never appears in attempt_log with role assignee for this quest; party_id = id exactly when party_role = contract; plot.branch is quest/<id>; unit ids are unique. Not checked by this schema because they need other files: secrets_required is a subset of territory.secrets_allowed; kind, class_required and tags are validated against the registry, and class_required is in kinds[kind].classes_allowed; no character who worked on any quest of a party (same party_id) verifies a quest of that party; status changes only through the transition table (domain/src/quest/transitions.ts).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "id",
    "title",
    "description",
    "kind",
    "rank",
    "territory",
    "tags",
    "status",
    "tier",
    "budget",
    "estimate",
    "attempts",
    "attempt_log",
    "plot",
    "deliverable",
    "seal_required",
    "created_by",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^q_[0-9]{8}_[0-9a-hjkmnp-tv-z]{6}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "description": "KindId, validated against registry/kinds.json (11 default kinds).",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "rank": {
      "$ref": "#/$defs/rank"
    },
    "territory": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,30}[a-z0-9])?$",
      "not": {
        "enum": [
          "global"
        ]
      }
    },
    "class_required": {
      "description": "ClassId the assignee must have (product plan 0.5 §4); must be one of kinds[kind].classes_allowed. Required when tier = session.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "tags": {
      "description": "Expertise tags from registry/tags.json, set by the Chancellor. Candidates of class_required are ranked by their reputation on these tags (character.skill_affinity), and up to 3 skills matching these tags and the territory are loaded into the prompt. A party part has one main tag.",
      "type": "array",
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "default": []
    },
    "party_id": {
      "description": "Party (đội) this quest belongs to: the id of the party's contract quest (kind plan, written by the party lead).",
      "type": "string",
      "pattern": "^q_[0-9]{8}_[0-9a-hjkmnp-tv-z]{6}$"
    },
    "party_role": {
      "description": "contract = the plan quest whose lead writes the contract and the parts; part = one area, one main tag, one character, one worktree, one verdict; acceptance = the blind trial's part (territory.blind_trial): acceptance tests another character writes from the contract and the description alone, never seeing the parts' work; merge = the final quest that merges the part branches and runs the full checks. The party is done when its merge quest is done.",
      "enum": [
        "contract",
        "part",
        "acceptance",
        "merge"
      ]
    },
    "contract": {
      "description": "Path of the contract inside the territory, e.g. apps/api/openapi.json, committed on the contract quest's branch. Parts and the merge quest branch from that branch, so they all see the same contract.",
      "type": "string",
      "minLength": 1
    },
    "scope_paths": {
      "description": "The files the quest changes, as globs relative to the territory root (`packages/domain/src/dispatch/**`). Within a territory the Steward never starts a quest whose scope meets the scope a quest holds (from its first run until it is archived, waiting for the owner's merge included), unless its plot is built on that quest's branch; a session-tier quest without a scope runs alone among working quests. Files the work changes outside the scope go into the `quest.submitted` line and the judge's prompt, never an automatic fail. Hot files every branch edits belong in territory.shared_paths, not here.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "status": {
      "enum": [
        "draft",
        "open",
        "claimed",
        "working",
        "review",
        "returned",
        "awaiting_seal",
        "done",
        "blocked",
        "paused_mana",
        "infirmary",
        "archived"
      ]
    },
    "tier": {
      "description": "Execution tier (ADR 0017). An apprentice (sub-agent) is not a quest tier: it happens inside a session.",
      "enum": [
        "script",
        "session"
      ],
      "default": "session"
    },
    "script": {
      "description": "Required when tier = script; id from registry/scripts.json. No model call, mana 0.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "params": {
          "description": "Validated against the script's params_schema.",
          "type": "object",
          "default": {}
        }
      }
    },
    "assignee": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,30}[a-z0-9])?$",
      "not": {
        "enum": [
          "user",
          "machine",
          "temple"
        ]
      }
    },
    "verifier": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,30}[a-z0-9])?$",
      "not": {
        "enum": [
          "user",
          "machine",
          "temple"
        ]
      }
    },
    "campaign_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^c_[0-9]{8}_[0-9a-hjkmnp-tv-z]{6}$"
    },
    "parent_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^q_[0-9]{8}_[0-9a-hjkmnp-tv-z]{6}$"
    },
    "depends_on": {
      "description": "Unfinished dependencies keep the quest blocked.",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^q_[0-9]{8}_[0-9a-hjkmnp-tv-z]{6}$"
      },
      "default": []
    },
    "budget": {
      "description": "Derived from kingdom.breakers and rank; the owner may edit it.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_minutes",
        "max_tokens",
        "max_attempts"
      ],
      "properties": {
        "max_minutes": {
          "type": "integer",
          "minimum": 1
        },
        "max_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "max_attempts": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "estimate": {
      "description": "The Chancellor's estimate.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tokens",
        "minutes"
      ],
      "properties": {
        "tokens": {
          "type": "integer",
          "minimum": 0
        },
        "minutes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "attempts": {
      "type": "integer",
      "minimum": 0,
      "default": 0
    },
    "attempt_log": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "n",
          "character",
          "role",
          "started_at",
          "run_dir"
        ],
        "properties": {
          "n": {
            "type": "integer",
            "minimum": 1
          },
          "character": {
            "description": "null for script-tier runs (the Steward runs the script).",
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-z0-9](?:[a-z0-9-]{0,30}[a-z0-9])?$",
            "not": {
              "enum": [
                "user",
                "machine",
                "temple"
              ]
            }
          },
          "role": {
            "enum": [
              "assignee",
              "verifier"
            ]
          },
          "started_at": {
            "type": "string",
            "format": "date-time"
          },
          "ended_at": {
            "type": "string",
            "format": "date-time"
          },
          "outcome": {
            "description": "timeout = the time breaker tripped; breaker = the token or turn breaker tripped; partial = a judge handed in a partial verdict (since P1-42, submitted before).",
            "enum": [
              "submitted",
              "partial",
              "returned",
              "timeout",
              "breaker",
              "crash",
              "paused",
              "blocked",
              "cancelled"
            ]
          },
          "session_id": {
            "type": "string",
            "minLength": 1
          },
          "tokens": {
            "type": "integer",
            "minimum": 0
          },
          "run_dir": {
            "description": "Relative to the kingdom: .runs/<quest>-<n> (verifier: .runs/<quest>-<n>/verify, and /verify-<k> for the k-th judge of the run, k ≥ 2).",
            "type": "string",
            "pattern": "^\\.runs/[^\\\\]+$"
          }
        }
      },
      "default": []
    },
    "plot": {
      "description": "The quest's own ground. worktree: absolute path <territory.path>/<worktree_dir>/<id> on branch quest/<id>; folder: quests/<id>/work (only for non-git territories).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "worktree",
            "folder",
            "none"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "branch": {
          "type": "string",
          "pattern": "^quest/q_[0-9]{8}_[0-9a-hjkmnp-tv-z]{6}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "worktree"
              }
            }
          },
          "then": {
            "required": [
              "path",
              "branch"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "folder"
              }
            }
          },
          "then": {
            "required": [
              "path"
            ]
          }
        }
      ]
    },
    "deliverable": {
      "description": "Delivery follows the kind's convention; delivered_at marks done-and-delivered (not a separate status).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "branch",
            "file",
            "report",
            "draft",
            "subquests",
            "none"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "delivered_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "seal_required": {
      "type": "boolean",
      "default": false
    },
    "seal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "at"
      ],
      "properties": {
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "blocked": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question",
        "asked_at"
      ],
      "properties": {
        "question": {
          "type": "string",
          "minLength": 1
        },
        "asked_at": {
          "type": "string",
          "format": "date-time"
        },
        "answer": {
          "type": "string"
        },
        "answered_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "objection": {
      "description": "(PS-22) The objection memo the next review answers: the Steward sets it when the run that filed it ends, and clears it with the second judge's verdict, or when the owner decides the memo first.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "memo",
        "verdict",
        "judge"
      ],
      "properties": {
        "memo": {
          "description": "The objection memo (memos/<memo>.json): which note is wrong, why, the evidence.",
          "type": "string",
          "pattern": "^m_[0-9]{8}_[0-9a-hjkmnp-tv-z]{6}$"
        },
        "verdict": {
          "description": "The fail verdict the objection contests.",
          "type": "string",
          "pattern": "^q_[0-9]{8}_[0-9a-hjkmnp-tv-z]{6}-[1-9][0-9]*(?:-p[1-9][0-9]*|-user)?$"
        },
        "judge": {
          "description": "That verdict's verifier_id: it never judges the objection (ADR 0008).",
          "type": "string",
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,30}[a-z0-9])?$"
        }
      }
    },
    "secrets_required": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "default": []
    },
    "checks_run": {
      "description": "Territory check ids selected after the work, from the paths actually touched.",
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "default": []
    },
    "units": {
      "description": "Batch quests: units produced by a script with produces = units. Units that need judgement become child session quests, not apprentices.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "outcome"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "outcome": {
            "description": "Muster after battle: done = kill, not_done = grave, needs_user = wounded, debt = ruin.",
            "enum": [
              "pending",
              "done",
              "not_done",
              "needs_user",
              "debt"
            ]
          },
          "child_quest": {
            "type": "string",
            "pattern": "^q_[0-9]{8}_[0-9a-hjkmnp-tv-z]{6}$"
          }
        }
      }
    },
    "created_by": {
      "enum": [
        "chancellor",
        "user",
        "council",
        "patrol",
        "battle",
        "campaign"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "$comment": "Script tier: a catalog script, no character.",
      "if": {
        "properties": {
          "tier": {
            "const": "script"
          }
        }
      },
      "then": {
        "required": [
          "script"
        ],
        "properties": {
          "assignee": {
            "type": "null"
          }
        }
      }
    },
    {
      "$comment": "Session tier: a character holds the quest while it is in flight; not a party's merge quest, whose run the Steward may make itself (P1-18).",
      "if": {
        "properties": {
          "tier": {
            "const": "session"
          },
          "status": {
            "enum": [
              "claimed",
              "working",
              "review",
              "returned",
              "awaiting_seal",
              "paused_mana"
            ]
          },
          "party_role": {
            "not": {
              "const": "merge"
            }
          }
        }
      },
      "then": {
        "required": [
          "assignee"
        ],
        "properties": {
          "assignee": {
            "type": "string"
          }
        }
      }
    },
    {
      "$comment": "A quest in review has had a run: an attempt, or the Steward's own run of a party's merge, which takes a run number and no attempt (P1-55).",
      "if": {
        "properties": {
          "status": {
            "const": "review"
          }
        }
      },
      "then": {
        "anyOf": [
          {
            "properties": {
              "attempts": {
                "minimum": 1
              }
            }
          },
          {
            "required": [
              "attempt_log"
            ],
            "properties": {
              "attempt_log": {
                "contains": {
                  "required": [
                    "role"
                  ],
                  "properties": {
                    "role": {
                      "const": "assignee"
                    }
                  }
                }
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "required": [
          "seal"
        ]
      },
      "then": {
        "properties": {
          "status": {
            "enum": [
              "done",
              "archived"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "blocked"
          }
        }
      },
      "then": {
        "required": [
          "blocked"
        ]
      }
    },
    {
      "$comment": "Session tier: the class is fixed when the quest is created.",
      "if": {
        "properties": {
          "tier": {
            "const": "session"
          }
        }
      },
      "then": {
        "required": [
          "class_required"
        ]
      }
    },
    {
      "$comment": "Party fields come together: a member has a role; parts, the acceptance part and the merge quest know the contract.",
      "if": {
        "required": [
          "party_id"
        ]
      },
      "then": {
        "required": [
          "party_role"
        ]
      }
    },
    {
      "if": {
        "required": [
          "party_role"
        ]
      },
      "then": {
        "required": [
          "party_id"
        ]
      }
    },
    {
      "if": {
        "required": [
          "party_role"
        ],
        "properties": {
          "party_role": {
            "enum": [
              "part",
              "acceptance",
              "merge"
            ]
          }
        }
      },
      "then": {
        "required": [
          "contract"
        ]
      }
    }
  ],
  "$defs": {
    "rank": {
      "enum": [
        "F",
        "E",
        "D",
        "C",
        "B",
        "A",
        "S"
      ]
    }
  },
  "examples": [
    {
      "version": 1,
      "id": "q_20261106_7k3m2a",
      "title": "Thêm script pnpm check",
      "description": "Thêm script `pnpm check` gom lint + typecheck + test + i18n:check đúng như README mô tả ở mục kiểm tra trước khi push; cập nhật README.",
      "kind": "build",
      "rank": "D",
      "class_required": "knight",
      "tags": [
        "infra"
      ],
      "territory": "dc1-se-team",
