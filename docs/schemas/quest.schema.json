      "depends_on": [],
      "budget": {
        "max_minutes": 45,
        "max_tokens": 400000,
        "max_attempts": 3
      },
      "estimate": {
        "tokens": 200000,
        "minutes": 30
      },
      "attempts": 1,
      "attempt_log": [
        {
          "n": 1,
          "character": "thorn",
          "role": "assignee",
          "started_at": "2026-11-06T09:12:03+07:00",
