{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elvaria.dev/schemas/event/v1",
  "title": "Event",
  "description": "One line of events/YYYY-MM-DD.jsonl (and of quests/<id>/journal.jsonl). The event log is append-only and never rewritten: readers upgrade old lines by `v` on read. `type` is `group.action`; `data` has a shape per type. Unknown types are kept by readers and ignored by renderers (forward compatible), so `type` is a pattern, not an enum; the v1 catalog is in $defs.known_types. The world sees actor.id (character) and the character's provider (tribe), never which CLI ran.",
  "$comment": "Hand-written v1, the reviewed target; from P0-03 generated by `pnpm schemas` from the discriminated union in packages/domain (ADR 0003). Events use `v`, not `version` (implementation-plan §2.1). Secrets are redacted before append (hook, runner, store, herald). Reserved prefixes with no v1 types yet: campaign.*, battle.*, incident.*, patrol.* (stage 5), party.* and skill.* (product plan 0.5: parties and skills). One write() per line under 64 KB; readers drop a last line without a trailing newline.",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "id", "ts", "type", "actor", "data"],
  "properties": {
    "v": { "const": 1 },
    "id": { "$ref": "#/$defs/ulid", "description": "ULID from IdSource; sortable by time." },
    "ts": { "type": "string", "format": "date-time" },
    "type": { "type": "string", "pattern": "^[a-z_]+(\\.[a-z_]+)+$" },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["character", "user", "steward", "chancellor", "herald", "system"] },
        "id": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,30}[a-z0-9])?$" }
      },
      "if": { "properties": { "kind": { "const": "character" } } },
      "then": { "required": ["id"] }
    },
    "quest": { "type": "string", "pattern": "^q_[0-9]{8}_[0-9a-hjkmnp-tv-z]{6}$" },
    "attempt": { "type": "integer", "minimum": 1 },
    "territory": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,30}[a-z0-9])?$" },
    "session": { "type": "string", "minLength": 1 },
    "data": { "type": "object", "default": {} }
  },
  "allOf": [
    { "if": { "properties": { "type": { "const": "agent.tool" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/data_agent_tool" } } } },
    { "if": { "properties": { "type": { "const": "agent.tool.blocked" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/data_agent_tool_blocked" } } } },
    { "if": { "properties": { "type": { "const": "agent.session.start" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/data_agent_session_start" } } } },
    { "if": { "properties": { "type": { "const": "agent.session.end" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/data_agent_session_end" } } } },
    { "if": { "properties": { "type": { "const": "agent.subagent.end" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/data_agent_subagent_end" } } } },
    { "if": { "properties": { "type": { "const": "agent.subagent.overrun" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/data_agent_subagent_overrun" } } } },
    { "if": { "properties": { "type": { "const": "mana.signal" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/data_mana_signal" } } } },
    { "if": { "properties": { "type": { "const": "mana.level" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/data_mana_level" } } } },
    { "if": { "properties": { "type": { "enum": ["command.applied", "command.rejected"] } } }, "then": { "properties": { "data": { "$ref": "#/$defs/data_command_result" } } } },
    { "if": { "properties": { "type": { "const": "quest.infirmary" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/data_quest_infirmary" } } } }
  ],
  "$defs": {
    "ulid": { "type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$" },
    "tool_kind": {
      "enum": ["read", "write", "bash", "web", "search", "other"],
      "description": "Normalised tool kind (implementation-plan §3.10): Read/Glob/Grep and read_file map to read, Edit/Write and write_file/replace to write, Bash and run_shell_command to bash, WebFetch/WebSearch to web."
    },
    "known_types": {
      "$comment": "v1 type catalog, for documentation and the generated docs/events.md. Not used to restrict `type`.",
      "enum": [
        "quest.drafted",
        "quest.created",
        "quest.claimed",
        "quest.released",
        "quest.started",
        "quest.submitted",
        "quest.returned",
        "quest.verdict",
        "quest.done",
        "quest.sealed",
        "quest.archived",
        "quest.blocked",
        "quest.unblocked",
        "quest.paused",
        "quest.resumed",
        "quest.infirmary",
        "quest.delivered",
        "agent.session.start",
        "agent.session.end",
        "agent.tool",
        "agent.tool.blocked",
        "agent.subagent.start",
        "agent.subagent.end",
        "agent.subagent.overrun",
        "agent.compact",
        "agent.notification",
        "verdict.pass",
        "verdict.fail",
        "verdict.partial",
        "mana.level",
        "mana.warning",
        "mana.exhausted",
        "mana.restored",
        "mana.probe",
        "mana.signal",
        "character.created",
        "character.sleep",
        "character.wake",
        "character.meditate",
        "character.suspend",
        "character.release",
        "character.swamp",
        "character.level_up",
        "character.level_down",
        "command.received",
        "command.applied",
        "command.rejected",
        "delivery.sent",
        "chronicle.written",
        "territory.attached",
        "territory.surveyed",
        "territory.health",
        "sandbox.replay.start",
        "sandbox.replay.end"
      ]
    },
    "data_agent_tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool"],
      "properties": {
        "tool": { "$ref": "#/$defs/tool_kind" },
        "path": { "type": "string", "minLength": 1, "description": "Relative to the plot, '/' separators." },
        "command": { "type": "string", "description": "Redacted." },
        "url": { "type": "string" },
        "exit": { "type": "integer" },
        "duration_ms": { "type": "integer", "minimum": 0 }
      }
    },
    "data_agent_tool_blocked": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "reason"],
      "properties": {
        "tool": { "$ref": "#/$defs/tool_kind" },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "data_agent_session_start": {
      "type": "object",
      "additionalProperties": false,
      "required": ["session", "model"],
      "properties": {
        "session": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$" }
      }
    },
    "data_agent_session_end": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome"],
      "properties": {
        "outcome": {
          "enum": ["completed", "max_turns", "budget", "killed", "error"],
          "description": "RunResult.outcome (implementation-plan §3.7)."
        },
        "usage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tokens"],
          "properties": {
            "tokens": { "type": "integer", "minimum": 0 },
            "turns": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "data_agent_subagent_end": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent_type", "duration_ms"],
      "properties": {
        "agent_type": { "type": "string", "minLength": 1 },
        "duration_ms": { "type": "integer", "minimum": 0 }
      }
    },
    "data_agent_subagent_overrun": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent_type", "duration_ms", "limit_minutes"],
      "properties": {
        "agent_type": { "type": "string", "minLength": 1 },
        "duration_ms": { "type": "integer", "minimum": 0 },
        "limit_minutes": { "type": "integer", "minimum": 1 }
      }
    },
    "data_mana_signal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["error", "source"],
      "description": "In-band 'out of mana' signal, e.g. error rate_limit from source stop_failure or api_retry.",
      "properties": {
        "error": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "source": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
      }
    },
    "data_mana_level": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tribe", "pool", "window", "used_pct", "source"],
      "properties": {
        "tribe": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$", "description": "TribeId from kingdom.tribes[]." },
        "pool": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "PoolId from poolOf(tribe, model): the tribe id for a single-pool account (claude), or the adapter's pool (antigravity: gemini_models, claude_gpt_models)."
        },
        "window": { "enum": ["five_hour", "weekly"] },
        "used_pct": { "type": "number", "minimum": 0, "maximum": 100 },
        "resets_at": { "type": "string", "format": "date-time" },
        "source": { "enum": ["rate_limits", "estimate", "signal"] }
      }
    },
    "data_command_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command_id"],
      "properties": {
        "command_id": { "$ref": "#/$defs/ulid" },
        "reason": { "type": "string" }
      }
    },
    "data_quest_infirmary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason"],
      "properties": {
        "reason": { "type": "string", "minLength": 1, "description": "e.g. breaker:time, breaker:tokens, max_attempts, script_error." }
      }
    }
  },
  "examples": [
    {
      "v": 1,
      "id": "01JCF8X4Z6Q3W9N2M5R7T8V0YB",
      "ts": "2026-11-06T09:12:03+07:00",
      "type": "agent.tool",
      "actor": { "kind": "character", "id": "thorn" },
      "quest": "q_20261106_7k3m2a",
      "attempt": 1,
      "territory": "dc1-se-team",
      "session": "6f1c2d9e-3b4a-4c8e-9f0a-1b2c3d4e5f60",
      "data": { "tool": "write", "path": "src/auth/login.ts" }
    },
    {
      "v": 1,
      "id": "01JCF9A2B3C4D5E6F7G8H9J0KM",
      "ts": "2026-11-06T12:39:17+07:00",
      "type": "mana.level",
      "actor": { "kind": "steward" },
      "data": {
        "tribe": "gemini",
        "pool": "gemini_models",
        "window": "five_hour",
        "used_pct": 42,
        "resets_at": "2026-11-06T17:39:17+07:00",
        "source": "rate_limits"
      }
    }
  ]
}
