{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elvaria.dev/schemas/script/v1",
  "title": "Registry: script catalog",
  "description": "registry/scripts.json in the kingdom: the catalog of the script tier (ADR 0017). A script-tier quest runs `node registry/scripts/<id>.mjs --params <json> [--context <json>]` in its plot, with no model, no secrets and mana 0; its verdict is issued by the Steward (`machine`) from the exit code and the output declared by `produces`. Only catalog scripts run: if a model writes a script and runs it, that is the session tier. Default catalog: link-check, run-check, count-files, diff-stat, compare-numbers. Adding a script = one .mjs file with tests + one entry here.",
  "$comment": "Generated by `pnpm schemas` from the zod source in packages/domain/src/schema (ADR 0003): change the zod source, never this file. Script ids are kebab-case because they name files; entry must be scripts/<id>.mjs (loader). params_schema is itself a JSON Schema (draft 2020-12) used to validate quest.script.params. Output contract on stdout: produces=report -> {summary, data}; produces=units -> {units: [{id, label, outcome}]}; produces=check -> {pass, details}. Exit codes and --context: implementation-plan §3.12.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "scripts"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "scripts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/script"
      }
    }
  },
  "$defs": {
    "script": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name_vi",
        "name_en",
        "description",
        "entry",
        "params_schema",
        "kinds",
        "produces",
        "timeout_minutes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "name_vi": {
          "type": "string",
          "minLength": 1
        },
        "name_en": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "entry": {
          "description": "Relative to registry/.",
          "type": "string",
          "pattern": "^scripts/[a-z][a-z0-9-]*\\.mjs$"
        },
        "params_schema": {
          "description": "JSON Schema for quest.script.params (open object).",
          "type": "object"
        },
        "kinds": {
          "description": "Quest kinds this script may serve.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        },
        "produces": {
          "description": "units feeds a batch quest's units[]; units needing judgement become child session quests.",
          "enum": [
            "report",
            "units",
            "check"
          ]
        },
        "timeout_minutes": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  },
  "examples": [
    {
      "version": 1,
      "scripts": [
        {
          "id": "link-check",
          "name_vi": "Kiểm tra link",
          "name_en": "Link check",
          "description": "Checks every internal link in the matched Markdown files; one unit per link, dead links are units with outcome not_done.",
          "entry": "scripts/link-check.mjs",
          "params_schema": {
            "type": "object",
            "required": [
              "globs"
            ],
            "properties": {
              "globs": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              }
            },
            "additionalProperties": false
          },
          "kinds": [
            "batch",
            "document",
            "research"
          ],
          "produces": "units",
          "timeout_minutes": 10
        },
        {
          "id": "run-check",
          "name_vi": "Chạy kiểm tra máy",
          "name_en": "Run check",
          "description": "Runs one territory check (checks[].id) and reports pass or fail with the log path.",
          "entry": "scripts/run-check.mjs",
          "params_schema": {
            "type": "object",
            "required": [
              "check_id"
            ],
            "properties": {
              "check_id": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "kinds": [
            "fix",
            "build",
            "refactor",
            "batch"
          ],
          "produces": "check",
          "timeout_minutes": 60
        },
        {
          "id": "count-files",
          "name_vi": "Đếm file",
          "name_en": "Count files",
          "description": "Counts files and lines per folder for the given globs.",
          "entry": "scripts/count-files.mjs",
          "params_schema": {
            "type": "object",
            "required": [
              "globs"
            ],
            "properties": {
              "globs": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              }
            },
            "additionalProperties": false
          },
          "kinds": [
            "analyze",
            "research"
          ],
          "produces": "report",
          "timeout_minutes": 5
        },
        {
          "id": "diff-stat",
          "name_vi": "Thống kê diff",
          "name_en": "Diff stat",
          "description": "git diff --stat between two refs, as data.",
          "entry": "scripts/diff-stat.mjs",
          "params_schema": {
            "type": "object",
            "required": [
              "base"
            ],
            "properties": {
              "base": {
                "type": "string"
              },
              "head": {
                "type": "string",
                "default": "HEAD"
              }
            },
            "additionalProperties": false
          },
          "kinds": [
            "refactor",
            "build",
            "analyze"
          ],
          "produces": "report",
          "timeout_minutes": 5
        },
        {
          "id": "compare-numbers",
          "name_vi": "So khớp số",
          "name_en": "Compare numbers",
          "description": "Compares the numbers in two JSON files within a tolerance.",
          "entry": "scripts/compare-numbers.mjs",
          "params_schema": {
            "type": "object",
            "required": [
              "expected_path",
              "actual_path"
            ],
            "properties": {
              "expected_path": {
                "type": "string"
              },
              "actual_path": {
                "type": "string"
              },
              "tolerance": {
                "type": "number",
                "minimum": 0,
                "default": 0
              }
            },
            "additionalProperties": false
          },
          "kinds": [
            "analyze"
          ],
          "produces": "check",
          "timeout_minutes": 5
        }
      ]
    }
  ]
}
