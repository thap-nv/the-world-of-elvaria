{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elvaria.dev/schemas/device/v1",
  "title": "Device",
  "description": "devices/<id>.json: one device paired with the Herald (P2-01, ADR 0037) and its role: full (everything the owner may do), scoped (the work of the listed territories) or inquiry (questions on the listed territories). The Herald gates every request and command by it and sends a limited device only the world of its territories; the Steward checks a command of source herald or lite against it again (deviceMay). Only the owner's commands write it.",
  "$comment": "Generated by `pnpm schemas` from the zod source in packages/domain/src/schema (ADR 0003): change the zod source, never this file. A full device carries no territories; scoped and inquiry carry at least one. The Herald's sessions (.state/herald-sessions.json, ADR 0031) name a device by this id.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "id",
        "label",
        "role",
        "created_at"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "id": {
          "type": "string",
          "pattern": "^dev_[0-9]{8}_[0-9a-hjkmnp-tv-z]{6}$"
        },
        "label": {
          "description": "The owner's name for it, from `elvaria herald pair --label`.",
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "role": {
          "const": "full"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "revoked_at": {
          "description": "Set once by `elvaria herald revoke`: from then on the Herald ends its session and the Steward refuses its commands (device_revoked). The file stays, so the log still names the device.",
          "type": "string",
          "format": "date-time"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "id",
        "label",
        "role",
        "territories",
        "created_at"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "id": {
          "type": "string",
          "pattern": "^dev_[0-9]{8}_[0-9a-hjkmnp-tv-z]{6}$"
        },
        "label": {
          "description": "The owner's name for it, from `elvaria herald pair --label`.",
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "role": {
          "const": "scoped"
        },
        "territories": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9](?:[a-z0-9-]{0,30}[a-z0-9])?$",
            "not": {
              "enum": [
                "global"
              ]
            }
          }
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "revoked_at": {
          "description": "Set once by `elvaria herald revoke`: from then on the Herald ends its session and the Steward refuses its commands (device_revoked). The file stays, so the log still names the device.",
          "type": "string",
          "format": "date-time"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "id",
        "label",
        "role",
        "territories",
        "created_at"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "id": {
          "type": "string",
          "pattern": "^dev_[0-9]{8}_[0-9a-hjkmnp-tv-z]{6}$"
        },
        "label": {
          "description": "The owner's name for it, from `elvaria herald pair --label`.",
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "role": {
          "const": "inquiry"
        },
        "territories": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9](?:[a-z0-9-]{0,30}[a-z0-9])?$",
            "not": {
              "enum": [
                "global"
              ]
            }
          }
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "revoked_at": {
          "description": "Set once by `elvaria herald revoke`: from then on the Herald ends its session and the Steward refuses its commands (device_revoked). The file stays, so the log still names the device.",
          "type": "string",
          "format": "date-time"
        }
      }
    }
  ],
  "examples": [
    {
      "version": 1,
      "id": "dev_20261126_7pzkfv",
      "label": "Owner's laptop",
      "role": "full",
      "created_at": "2026-11-26T09:12:40+07:00"
    },
    {
      "version": 1,
      "id": "dev_20261126_4k2pqz",
      "label": "Phone at the office",
      "role": "scoped",
      "territories": [
        "dc1-se-team"
      ],
      "created_at": "2026-11-26T09:20:03+07:00"
    },
    {
      "version": 1,
      "id": "dev_20261126_9tw3hx",
      "label": "Tablet of the BA",
      "role": "inquiry",
      "territories": [
        "dc1-se-team",
        "handbook"
      ],
      "created_at": "2026-11-26T10:02:18+07:00",
      "revoked_at": "2026-11-26T17:45:00+07:00"
    }
  ]
}
