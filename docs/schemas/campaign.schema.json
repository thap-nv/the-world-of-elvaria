{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elvaria.dev/schemas/campaign/v1",
  "title": "Campaign",
  "description": "campaigns/<id>.json: a war (campaign) is a container for quests, not a leaf kind. Offense = release, launch, epic, deadline; defense = incident, vulnerability, crisis. Fronts group quests; victory conditions are checkable. Morale is derived (completion ratio over remaining time) and never stored.",
  "$comment": "Generated by `pnpm schemas` from the zod source in packages/domain/src/schema (ADR 0003): change the zod source, never this file. Used from stage 5; the schema exists from stage 0 so later stages need no domain change. Not expressible here: front ids are unique; victory condition ids are unique.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "id",
    "name",
    "mode",
    "fronts",
    "victory_conditions",
    "status",
    "declared_at"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^c_[0-9]{8}_[0-9a-hjkmnp-tv-z]{6}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "mode": {
      "enum": [
        "offense",
        "defense"
      ]
    },
    "fronts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "goal",
          "quest_ids"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9](?:[a-z0-9-]{0,30}[a-z0-9])?$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "goal": {
            "type": "string",
            "minLength": 1
          },
          "quest_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^q_[0-9]{8}_[0-9a-hjkmnp-tv-z]{6}$"
            }
          }
        }
      }
    },
    "victory_conditions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text",
          "check",
          "met"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9](?:[a-z0-9-]{0,30}[a-z0-9])?$"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "check": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "enum": [
                  "all_quests_done",
                  "command"
                ]
              },
              "run": {
                "description": "Command run in the territory; exit 0 = met.",
                "type": "string",
                "minLength": 1
              }
            },
            "if": {
              "properties": {
                "type": {
                  "const": "command"
                }
              }
            },
            "then": {
              "required": [
                "run"
              ]
            }
          },
          "met": {
            "type": "boolean",
            "default": false
          },
          "checked_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "status": {
      "enum": [
        "declared",
        "active",
        "won",
        "lost",
        "retro_pending",
        "closed"
      ]
    },
    "declared_at": {
      "type": "string",
      "format": "date-time"
    },
    "deadline": {
      "type": "string",
      "format": "date-time"
    },
    "retro_path": {
      "description": "Relative to the kingdom; the post-war council (retro or postmortem).",
      "type": "string",
      "minLength": 1
    },
    "closed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "closed"
          }
        }
      },
      "then": {
        "required": [
          "closed_at"
        ]
      }
    }
  ],
  "examples": [
    {
      "version": 1,
      "id": "c_20261110_5m8q2r",
      "name": "Phát hành v1.4",
      "mode": "offense",
      "fronts": [
        {
          "id": "web",
          "name": "Mặt trận web",
          "goal": "L5 chờ xác nhận nổi bật trên dashboard",
          "quest_ids": [
            "q_20261110_2a4b6c",
            "q_20261110_8d9e7f"
          ]
        },
        {
          "id": "docs",
          "name": "Mặt trận tài liệu",
          "goal": "docs/architecture.md khớp ADR 0014-0018",
          "quest_ids": [
            "q_20261110_3g5h7j"
          ]
        }
      ],
      "victory_conditions": [
        {
          "id": "all-fronts",
          "text": "Mọi quest của hai mặt trận xong",
          "check": {
            "type": "all_quests_done"
          },
          "met": false
        },
        {
          "id": "ci-green",
          "text": "pnpm check xanh trên nhánh main",
          "check": {
            "type": "command",
            "run": "pnpm check"
          },
          "met": false
        }
      ],
      "status": "active",
      "declared_at": "2026-11-10T09:00:00+07:00",
      "deadline": "2026-11-21T18:00:00+07:00"
    }
  ]
}
