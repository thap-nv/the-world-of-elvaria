{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elvaria.dev/schemas/territory/v1",
  "title": "Territory",
  "description": "territories/<id>/territory.json: one repo or folder attached to the kingdom ('opening a realm'). Holds how to set up and check work there (commands, checks), the territory's own laws enforced at the runner (deny lists and hooks, not only the prompt), allowed secret names, and health.",
  "$comment": "Hand-written v1, the reviewed target; from P0-03 generated by `pnpm schemas` from zod (ADR 0003). There is no `map` field: region geometry lives only in world/map.json (world-map schema) and the level of detail is computed by the Herald from camera and territory count, so it is never stored here.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "id", "name", "path", "kind", "vcs"],
  "properties": {
    "version": { "const": 1 },
    "id": { "$ref": "#/$defs/slug", "description": "Slug chosen by the owner; defaults to the repo folder name." },
    "name": { "type": "string", "minLength": 1, "maxLength": 24 },
    "path": { "$ref": "#/$defs/abs_path" },
    "kind": { "enum": ["code", "docs", "content", "data", "mixed"] },
    "vcs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "enum": ["git", "none"] },
        "default_branch": { "type": "string", "minLength": 1 },
        "remote": { "type": "string", "minLength": 1 }
      },
      "if": { "properties": { "type": { "const": "git" } } },
      "then": { "required": ["default_branch"] }
    },
    "worktree_dir": {
      "type": "string",
      "pattern": "^[^\\\\]+$",
      "default": ".elvaria/worktrees",
      "description": "Relative to `path`; one sub-folder per quest id. Added to .git/info/exclude on attach. Switch to ../<repo>.elvaria/worktrees if spike P1-02 shows the main checkout's CLAUDE.md being loaded twice."
    },
    "max_concurrent": {
      "type": "integer",
      "minimum": 1,
      "default": 1,
      "description": "Quests running at once on this territory. Stage 1 keeps code territories at 1 because files a quest will touch cannot be known in advance."
    },
    "context_files": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "default": ["CLAUDE.md", "README.md", ".claude/rules/*.md"],
      "description": "Globs loaded for the Gemini tribe through a generated GEMINI.md (implementation-plan §3.8)."
    },
    "commands": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "setup": { "type": "string", "description": "Run once when a plot is prepared." },
        "test": { "type": "string" },
        "lint": { "type": "string" },
        "typecheck": { "type": "string" },
        "build": { "type": "string" }
      }
    },
    "checks": {
      "type": "array",
      "default": [],
      "description": "'What you touch decides what runs', as data. runChecks selects checks whose `when` globs match the touched paths.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "run", "when", "timeout_minutes"],
        "properties": {
          "id": { "$ref": "#/$defs/check_id" },
          "run": { "type": "string", "minLength": 1, "description": "A pnpm/node/git command without shell syntax (runs the same under Git Bash and PowerShell)." },
          "when": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "exclusive": { "type": "boolean", "default": false, "description": "Never run in parallel with another quest's exclusive check on this territory (Docker, e2e)." },
          "timeout_minutes": { "type": "integer", "minimum": 1 },
          "cleanup": { "type": "string", "description": "Optional command run after a kill or timeout (orphan containers, locks)." }
        }
      }
    },
    "laws": {
      "type": "object",
      "additionalProperties": false,
      "description": "Territory laws, enforced by generated deny rules and the PreToolUse hook. Deny rules are a fence, not a sandbox.",
      "properties": {
        "forbidden_paths": { "type": "array", "items": { "type": "string", "minLength": 1 }, "default": [] },
        "forbidden_commands": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "default": [],
          "description": "Regular expressions matched against normalised commands (bash and PowerShell)."
        },
        "read_before_write": { "type": "array", "items": { "type": "string", "minLength": 1 }, "default": [] },
        "rank_floor": {
          "type": "array",
          "default": [],
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["glob", "min_rank"],
            "properties": {
              "glob": { "type": "string", "minLength": 1 },
              "min_rank": { "$ref": "#/$defs/rank" }
            }
          }
        }
      }
    },
    "secrets_allowed": {
      "type": "array",
      "items": { "$ref": "#/$defs/secret_name" },
      "uniqueItems": true,
      "default": [],
      "description": "Names in the treasury that quests on this territory may request (quest.secrets_required must be a subset)."
    },
    "buildings": {
      "type": "array",
      "default": [],
      "description": "Stage 4: produced by the land survey (module -> building, tests -> walls, docs -> shelves).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "source", "label"],
        "properties": {
          "id": { "$ref": "#/$defs/slug" },
          "kind": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "source": { "type": "string", "minLength": 1, "description": "Path or glob in the territory this building stands for." },
          "label": { "type": "string", "minLength": 1 }
        }
      }
    },
    "health": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ci": { "enum": ["green", "red", "unknown"], "default": "unknown" },
        "open_bugs": { "type": "integer", "minimum": 0, "default": 0 },
        "last_patrol_at": { "type": "string", "format": "date-time" }
      }
    },
    "surveyed_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,30}[a-z0-9])?$" },
    "abs_path": { "type": "string", "pattern": "^(?:[A-Za-z]:/|/)[^\\\\]*$" },
    "check_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "secret_name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "rank": { "enum": ["F", "E", "D", "C", "B", "A", "S"] }
  },
  "examples": [
    {
      "version": 1,
      "id": "dc1-se-team",
      "name": "dc1-se-team",
      "path": "D:/Dummy/Tool - DC1/dc1-se-team",
      "kind": "code",
      "vcs": { "type": "git", "default_branch": "main", "remote": "https://github.com/thap-nv/dc1-se-team.git" },
      "worktree_dir": ".elvaria/worktrees",
      "max_concurrent": 1,
      "context_files": ["CLAUDE.md", "README.md", ".claude/rules/*.md"],
      "commands": {
        "setup": "pnpm install --prefer-offline",
        "test": "pnpm test",
        "lint": "pnpm lint",
        "typecheck": "pnpm typecheck"
      },
      "checks": [
        { "id": "lint", "run": "pnpm lint", "when": ["**/*.ts", "**/*.tsx"], "timeout_minutes": 10 },
        { "id": "typecheck", "run": "pnpm -r typecheck", "when": ["apps/**", "packages/**"], "timeout_minutes": 10 },
        { "id": "unit", "run": "pnpm -r test", "when": ["packages/shared/**", "apps/**/*.ts"], "timeout_minutes": 15 },
        { "id": "openapi", "run": "pnpm api:openapi", "when": ["apps/api/src/modules/**"], "timeout_minutes": 5 },
        { "id": "i18n", "run": "pnpm i18n:check", "when": ["apps/web/src/locales/**", "packages/shared/src/content/**"], "timeout_minutes": 5 },
        {
          "id": "e2e",
          "run": "pnpm e2e",
          "when": ["apps/web/src/routes/**", "apps/web/src/features/**"],
          "exclusive": true,
          "timeout_minutes": 60,
          "cleanup": "pnpm e2e:reset"
        }
      ],
      "laws": {
        "forbidden_paths": [".env", ".env.*", "infra/secrets/**"],
        "forbidden_commands": ["git\\s+(-C\\s+\\S+\\s+)?push", "drizzle-kit\\s+(drop|push)", "docker\\s+compose\\s+.*down\\s+-v"],
        "read_before_write": ["packages/shared/src/scoring/**", "packages/shared/src/auth/**", "apps/api/src/infra/db/migrations/**"],
        "rank_floor": [{ "glob": "packages/shared/src/auth/permissions.ts", "min_rank": "B" }]
      },
      "secrets_allowed": [],
      "buildings": [],
      "health": { "ci": "green", "open_bugs": 0 },
      "surveyed_at": "2026-11-06T10:00:00+07:00"
    }
  ]
}
