{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elvaria.dev/schemas/territory/v1",
  "title": "Territory",
  "description": "territories/<id>/territory.json: one repo or folder attached to the kingdom ('opening a realm'). Holds how to set up and check work there (commands, checks), the territory's own laws enforced at the runner (deny lists and hooks, not only the prompt), allowed secret names, and health.",
  "$comment": "Generated by `pnpm schemas` from the zod source in packages/domain/src/schema (ADR 0003): change the zod source, never this file. There is no `map` field: region geometry lives only in world/map.json (world-map schema) and the level of detail is computed by the Herald from camera and territory count, so it is never stored here. Not expressible here: check ids are unique; laws.forbidden_commands must compile as regular expressions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "id",
    "name",
    "path",
    "kind",
    "vcs"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "id": {
      "description": "Slug chosen by the owner; defaults to the repo folder name.",
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,30}[a-z0-9])?$",
      "not": {
        "enum": [
          "global"
        ]
      }
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 24
    },
    "path": {
      "$ref": "#/$defs/abs_path"
    },
    "kind": {
      "enum": [
        "code",
        "docs",
        "content",
        "data",
        "mixed"
      ]
    },
    "vcs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "git",
            "none"
          ]
        },
        "default_branch": {
          "type": "string",
          "minLength": 1
        },
        "remote": {
          "type": "string",
          "minLength": 1
        }
      },
      "if": {
        "properties": {
          "type": {
            "const": "git"
          }
        }
      },
      "then": {
        "required": [
          "default_branch"
        ]
      }
    },
    "worktree_dir": {
      "description": "Relative to `path`; one sub-folder per quest id. Added to .git/info/exclude on attach. Switch to ../<repo>.elvaria/worktrees if spike P1-02 shows the main checkout's CLAUDE.md being loaded twice.",
      "type": "string",
      "pattern": "^[^\\\\]+$",
      "default": ".elvaria/worktrees"
    },
    "max_concurrent": {
      "description": "Quests running at once on this territory. Stage 1 keeps code territories at 1 because files a quest will touch cannot be known in advance.",
      "type": "integer",
      "minimum": 1,
      "default": 1
    },
    "context_files": {
      "description": "Globs loaded for the Gemini tribe through a generated GEMINI.md (implementation-plan §3.8).",
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": [
        "CLAUDE.md",
        "README.md",
        ".claude/rules/*.md"
      ]
    },
    "commands": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "setup": {
          "description": "Run once when a plot is prepared.",
          "type": "string"
        },
        "test": {
          "type": "string"
        },
        "lint": {
          "type": "string"
        },
        "typecheck": {
          "type": "string"
        },
        "build": {
          "type": "string"
        },
        "generate": {
          "description": "Generators of the territory (`pnpm docs:gen`, `pnpm schemas`). A session that may edit files may run them: they are how files under laws.read_only_paths change.",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "default": {}
    },
    "checks": {
      "description": "'What you touch decides what runs', as data. runChecks selects checks whose `when` globs match the touched paths. Ids are unique (zod): run-check finds a check by id.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "run",
          "when",
          "timeout_minutes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "run": {
            "description": "A pnpm/node/git command without shell syntax (runs the same under Git Bash and PowerShell).",
            "type": "string",
            "minLength": 1
          },
          "when": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "exclusive": {
            "description": "Never run in parallel with another quest's exclusive check on this territory (Docker, e2e).",
            "type": "boolean",
            "default": false
          },
          "timeout_minutes": {
            "type": "integer",
            "minimum": 1
          },
          "cleanup": {
            "description": "Optional command run after a kill or timeout (orphan containers, locks).",
            "type": "string"
          }
        }
      },
      "default": []
    },
    "laws": {
      "description": "Territory laws, enforced by generated deny rules and the PreToolUse hook. Deny rules are a fence, not a sandbox.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "forbidden_paths": {
          "description": "Globs no session may read or write (secrets).",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": []
        },
        "read_only_paths": {
          "description": "Globs every session may read and no tool may write by hand: generated files, which only the territory's commands.generate rewrite.",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": []
        },
        "forbidden_commands": {
          "description": "Regular expressions matched against normalised commands (bash and PowerShell).",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": []
        },
        "read_before_write": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": []
        },
        "rank_floor": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "glob",
              "min_rank"
            ],
            "properties": {
              "glob": {
                "type": "string",
                "minLength": 1
              },
              "min_rank": {
                "$ref": "#/$defs/rank"
              }
            }
          },
          "default": []
        }
      },
      "default": {}
    },
    "secrets_allowed": {
      "description": "Names in the treasury that quests on this territory may request (quest.secrets_required must be a subset).",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "default": []
    },
    "buildings": {
      "description": "Stage 4: produced by the land survey (module -> building, tests -> walls, docs -> shelves).",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "source",
          "label"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9](?:[a-z0-9-]{0,30}[a-z0-9])?$"
          },
          "kind": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "source": {
            "description": "Path or glob in the territory this building stands for.",
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "default": []
    },
    "health": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ci": {
          "enum": [
            "green",
            "red",
            "unknown"
          ],
          "default": "unknown"
        },
        "open_bugs": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "last_patrol_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "default": {}
    },
    "surveyed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "abs_path": {
      "description": "Absolute path with '/' separators (Windows drive or POSIX root); no backslashes in data files.",
      "type": "string",
      "pattern": "^(?:[A-Za-z]:/|/)[^\\\\]*$"
    },
    "rank": {
      "enum": [
        "F",
        "E",
        "D",
        "C",
        "B",
        "A",
        "S"
      ]
    }
  },
  "examples": [
    {
      "version": 1,
      "id": "dc1-se-team",
      "name": "dc1-se-team",
      "path": "D:/Dummy/Tool - DC1/dc1-se-team",
      "kind": "code",
      "vcs": {
        "type": "git",
        "default_branch": "main",
        "remote": "https://github.com/thap-nv/dc1-se-team.git"
      },
      "worktree_dir": ".elvaria/worktrees",
      "max_concurrent": 1,
      "context_files": [
        "CLAUDE.md",
        "README.md",
        ".claude/rules/*.md"
      ],
      "commands": {
        "setup": "pnpm install --prefer-offline",
        "test": "pnpm test",
        "lint": "pnpm lint",
        "typecheck": "pnpm typecheck",
        "generate": [
          "pnpm api:openapi"
        ]
      },
      "checks": [
        {
          "id": "lint",
          "run": "pnpm lint",
          "when": [
            "**/*.ts",
            "**/*.tsx"
          ],
          "timeout_minutes": 10
        },
        {
          "id": "typecheck",
          "run": "pnpm -r typecheck",
          "when": [
            "apps/**",
            "packages/**"
          ],
          "timeout_minutes": 10
        },
        {
          "id": "unit",
          "run": "pnpm -r test",
          "when": [
            "packages/shared/**",
            "apps/**/*.ts"
          ],
          "timeout_minutes": 15
        },
        {
          "id": "openapi",
          "run": "pnpm api:openapi",
          "when": [
            "apps/api/src/modules/**"
          ],
          "timeout_minutes": 5
        },
        {
          "id": "i18n",
          "run": "pnpm i18n:check",
          "when": [
            "apps/web/src/locales/**",
            "packages/shared/src/content/**"
          ],
          "timeout_minutes": 5
        },
        {
          "id": "e2e",
          "run": "pnpm e2e",
          "when": [
            "apps/web/src/routes/**",
            "apps/web/src/features/**"
          ],
          "exclusive": true,
          "timeout_minutes": 60,
          "cleanup": "pnpm e2e:reset"
        }
      ],
      "laws": {
        "forbidden_paths": [
          ".env",
          ".env.*",
          "infra/secrets/**"
        ],
        "read_only_paths": [
          "apps/api/openapi.json",
          "packages/shared/src/api-types.ts"
        ],
        "forbidden_commands": [
          "git\\s+(-C\\s+\\S+\\s+)?push",
          "drizzle-kit\\s+(drop|push)",
          "docker\\s+compose\\s+.*down\\s+-v"
        ],
        "read_before_write": [
          "packages/shared/src/scoring/**",
          "packages/shared/src/auth/**",
          "apps/api/src/infra/db/migrations/**"
        ],
        "rank_floor": [
          {
            "glob": "packages/shared/src/auth/permissions.ts",
            "min_rank": "B"
          }
        ]
      },
      "secrets_allowed": [],
      "buildings": [],
      "health": {
        "ci": "green",
        "open_bugs": 0
      },
      "surveyed_at": "2026-11-06T10:00:00+07:00"
    }
  ]
}
