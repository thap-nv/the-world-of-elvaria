{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elvaria.dev/schemas/world-map/v1",
  "title": "World map",
  "description": "world/map.json in the kingdom (stage 3): one region per attached territory, placed on the map when the realm is opened. Minimal v1: anchor, polygon bounds on the ground plane (x, z in metres) and roads to other regions. Terrain, buildings and level of detail are derived (Three.js world and the 2D lite client both draw from this file plus WorldState).",
  "$comment": "Generated by `pnpm schemas` from the zod source in packages/domain/src/schema (ADR 0003): change the zod source, never this file. The schema exists from stage 0 so stage 3 needs no domain change; heightmap and survey data are added in later versions with a migration. Not expressible here: region ids unique; roads_to refer to existing regions; each territory has at most one region.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "generated_at",
    "regions"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "regions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "territory",
          "anchor",
          "bounds",
          "roads_to"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9](?:[a-z0-9-]{0,30}[a-z0-9])?$"
          },
          "territory": {
            "type": "string",
            "pattern": "^[a-z0-9](?:[a-z0-9-]{0,30}[a-z0-9])?$",
            "not": {
              "enum": [
                "global"
              ]
            }
          },
          "anchor": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "x",
              "z"
            ],
            "properties": {
              "x": {
                "type": "number"
              },
              "z": {
                "type": "number"
              }
            }
          },
          "bounds": {
            "description": "Polygon, counter-clockwise.",
            "type": "array",
            "minItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "x",
                "z"
              ],
              "properties": {
                "x": {
                  "type": "number"
                },
                "z": {
                  "type": "number"
                }
              }
            }
          },
          "roads_to": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9](?:[a-z0-9-]{0,30}[a-z0-9])?$"
            }
          }
        }
      }
    }
  },
  "examples": [
    {
      "version": 1,
      "generated_at": "2026-11-20T10:00:00+07:00",
      "regions": [
        {
          "id": "dc1-se-team",
          "territory": "dc1-se-team",
          "anchor": {
            "x": 0,
            "z": 0
          },
          "bounds": [
            {
              "x": -120,
              "z": -90
            },
            {
              "x": 130,
              "z": -80
            },
            {
              "x": 140,
              "z": 100
            },
            {
              "x": -110,
              "z": 95
            }
          ],
          "roads_to": [
            "the-world-of-elvaria"
          ]
        },
        {
          "id": "the-world-of-elvaria",
          "territory": "the-world-of-elvaria",
          "anchor": {
            "x": 320,
            "z": 40
          },
          "bounds": [
            {
              "x": 220,
              "z": -40
            },
            {
              "x": 420,
              "z": -30
            },
            {
              "x": 410,
              "z": 130
            }
          ],
          "roads_to": [
            "dc1-se-team"
          ]
        }
      ]
    }
  ]
}
