{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elvaria.dev/schemas/character/v1",
  "title": "Character",
  "description": "characters/<id>/character.json: one agent as a character with one class (fixed for life), one tribe and one model. Personal scripture lives next to it in scripture.md. Skills are not attached to characters: they live in temple/skills and are loaded per quest by tag. Gear tier, pool, model family, reputation and per-tag pass/fail counts and the title are derived by pure functions in packages/domain (gearTierOf, poolOf, familyOf, reputationOf, affinityOf, titleOf) and are never stored.",
  "$comment": "Generated by `pnpm schemas` from the zod source in packages/domain/src/schema (ADR 0003): change the zod source, never this file. Not expressible here: class must exist in registry/classes.json; vow_no_production must be true when the class is_verifier or is_monk; level changes only through levelChange(window, level).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "id",
    "name",
    "class",
    "tribe",
    "model",
    "level",
    "reputation",
    "status",
    "status_since",
    "vow_no_production",
    "consecutive_fail",
    "stats",
    "created_at"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,30}[a-z0-9])?$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 24
    },
    "class": {
      "description": "ClassId from registry/classes.json.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "tribe": {
      "description": "TribeId from kingdom.tribes[] (account and mana source), fixed for life like the class: reputation was earned with this tribe's models. Moving work to a new tribe means summoning new characters. The tribe's display name is theme data.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "model": {
      "description": "Full CLI model slug, e.g. claude-sonnet-5-5, gemini-4-argon-medium, claude-opus-5-5-low.",
      "$ref": "#/$defs/model_slug"
    },
    "level": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10,
      "default": 1
    },
    "reputation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "window"
      ],
      "properties": {
        "window": {
          "description": "Last 20 verdicts on this character's work. A human verdict (royal seal or return) weighs 3x.",
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "verdict_id",
              "result",
              "by_human",
              "at"
            ],
            "properties": {
              "verdict_id": {
                "type": "string",
                "pattern": "^q_[0-9]{8}_[0-9a-hjkmnp-tv-z]{6}-[1-9][0-9]*$"
              },
              "result": {
                "description": "Partial verdicts (verifier ran out of mana) are not a judgement and never enter a window.",
                "enum": [
                  "pass",
                  "fail"
                ]
              },
              "by_human": {
                "type": "boolean"
              },
              "at": {
                "type": "string",
                "format": "date-time"
              }
            }
          },
          "default": []
        }
      }
    },
    "skill_affinity": {
      "description": "Reputation per expertise tag (product plan 0.5 §6): every verdict on a quest adds an entry to the window of each of the quest's tags. Expertise is this data, not a sub-class: the Steward filters by class, then ranks by affinity on the quest's tags. pass/fail counts are derived (affinityOf), never stored.",
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "window"
        ],
        "properties": {
          "window": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "verdict_id",
                "result",
                "by_human",
                "at"
              ],
              "properties": {
                "verdict_id": {
                  "type": "string",
                  "pattern": "^q_[0-9]{8}_[0-9a-hjkmnp-tv-z]{6}-[1-9][0-9]*$"
                },
                "result": {
                  "description": "Partial verdicts (verifier ran out of mana) are not a judgement and never enter a window.",
                  "enum": [
                    "pass",
                    "fail"
                  ]
                },
                "by_human": {
                  "type": "boolean"
                },
                "at": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            }
          }
        }
      },
      "default": {}
    },
    "pinned_tag": {
      "description": "Tag the owner pinned this character to (lệnh pin_tag). It ranks first for this character and gives the title. The title shown over the head is derived (titleOf: pinned_tag, else the tag with the best affinity; display string from theme data), never stored.",
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-z][a-z0-9_]*$",
      "default": null
    },
    "status": {
      "enum": [
        "idle",
        "working",
        "reviewing",
        "sleeping_mana",
        "meditating",
        "suspended",
        "swamp"
      ]
    },
    "status_since": {
      "type": "string",
      "format": "date-time"
    },
    "status_before_sleep": {
      "description": "Status to restore on mana.restored; required while sleeping_mana.",
      "enum": [
        "idle",
        "working",
        "reviewing"
      ]
    },
    "current": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "quest",
        "role"
      ],
      "properties": {
        "quest": {
          "type": "string",
          "pattern": "^q_[0-9]{8}_[0-9a-hjkmnp-tv-z]{6}$"
        },
        "role": {
          "enum": [
            "assignee",
            "verifier"
          ]
        }
      }
    },
    "vow_no_production": {
      "description": "True for verifier and monk classes: no Edit/Write tools, enforced in the generated settings, not only the prompt.",
      "type": "boolean"
    },
    "tools": {
      "description": "Overrides of the class default tool policy.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allow": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "deny": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "consecutive_fail": {
      "description": "same_fail_suspend failures of the same fail_kind in a row suspend the character to the Temple.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "count"
      ],
      "properties": {
        "fail_kind": {
          "enum": [
            "tests_fail",
            "scope_creep",
            "missing_i18n",
            "wrong_facts",
            "incomplete",
            "style",
            "unsafe",
            "other"
          ]
        },
        "count": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        }
      }
    },
    "stats": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "quests_done",
        "tokens_today",
        "tokens_day"
      ],
      "properties": {
        "quests_done": {
          "type": "integer",
          "minimum": 0
        },
        "tokens_today": {
          "type": "integer",
          "minimum": 0
        },
        "tokens_day": {
          "description": "Local day that tokens_today refers to.",
          "type": "string",
          "format": "date"
        },
        "last_active_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "sleeping_mana"
          }
        }
      },
      "then": {
        "required": [
          "status_before_sleep"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "working"
          }
        }
      },
      "then": {
        "required": [
          "current"
        ],
        "properties": {
          "current": {
            "type": "object",
            "properties": {
              "role": {
                "const": "assignee"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "reviewing"
          }
        }
      },
      "then": {
        "required": [
          "current"
        ],
        "properties": {
          "current": {
            "type": "object",
            "properties": {
              "role": {
                "const": "verifier"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "model_slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]*$"
    }
  },
  "examples": [
    {
      "version": 1,
      "id": "thorn",
      "name": "Thorn",
      "class": "knight",
      "tribe": "claude",
      "model": "claude-sonnet-5-5",
      "level": 3,
      "reputation": {
        "window": [
          {
            "verdict_id": "q_20261105_4c8n2d-1",
            "result": "pass",
            "by_human": false,
            "at": "2026-11-05T16:20:00+07:00"
          },
          {
            "verdict_id": "q_20261105_4c8n2d-2",
            "result": "pass",
            "by_human": true,
            "at": "2026-11-05T18:02:00+07:00"
          }
        ]
      },
      "skill_affinity": {
        "frontend": {
          "window": [
            {
              "verdict_id": "q_20261105_4c8n2d-1",
              "result": "pass",
              "by_human": false,
              "at": "2026-11-05T16:20:00+07:00"
            },
            {
              "verdict_id": "q_20261105_4c8n2d-2",
              "result": "pass",
              "by_human": true,
              "at": "2026-11-05T18:02:00+07:00"
            }
          ]
        },
        "i18n": {
          "window": [
            {
              "verdict_id": "q_20261105_4c8n2d-2",
              "result": "pass",
              "by_human": true,
              "at": "2026-11-05T18:02:00+07:00"
            }
          ]
        }
      },
      "pinned_tag": null,
      "status": "working",
      "status_since": "2026-11-06T09:12:03+07:00",
      "current": {
        "quest": "q_20261106_7k3m2a",
        "role": "assignee"
      },
      "vow_no_production": false,
      "consecutive_fail": {
        "count": 0
      },
      "stats": {
        "quests_done": 4,
        "tokens_today": 182340,
        "tokens_day": "2026-11-06",
        "last_active_at": "2026-11-06T09:41:20+07:00"
      },
      "created_at": "2026-11-05T08:00:00+07:00"
    },
    {
      "version": 1,
      "id": "sable",
      "name": "Sable",
      "class": "judge",
      "tribe": "gemini",
      "model": "gemini-4-argon-high",
      "level": 1,
      "reputation": {
        "window": []
      },
      "status": "sleeping_mana",
      "status_since": "2026-11-06T11:30:00+07:00",
      "status_before_sleep": "idle",
      "current": null,
      "vow_no_production": true,
      "tools": {
        "deny": [
          "WebFetch"
        ]
      },
      "consecutive_fail": {
        "count": 0
      },
      "stats": {
        "quests_done": 0,
        "tokens_today": 0,
        "tokens_day": "2026-11-06"
      },
      "created_at": "2026-11-06T08:00:00+07:00"
    }
  ]
}
