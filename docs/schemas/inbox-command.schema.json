{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elvaria.dev/schemas/inbox-command/v1",
  "title": "Inbox command",
  "description": "inbox/<ulid>.json: one command from the owner (CLI, Herald, lite phone client) waiting for the Steward, the single writer of quest state (ADR 0005). The Steward applies commands in id order at the start of every tick, appends command.applied or command.rejected, and moves the file to inbox/done/. Idempotent: a command id that already has a command.applied event is skipped. Kinds match the design's action icons (seal, return, summon, suspend, reassign, archive, temple, declare) plus the lifecycle commands the state machine needs.",
  "$comment": "Hand-written v1, the reviewed target; from P0-03 generated by `pnpm schemas` from zod (ADR 0003). confirm (draft -> open) and edit_quest (`elvaria quest edit`) are additions to the plan's §2.3 list, required by the single-writer rule; pin_tag (pin a character to an expertise tag, product plan 0.5 §6) was added with plan 0.5. archive covers discard (draft), reject (awaiting_seal) and archive (done, infirmary); the Steward picks the transition from the quest's current status. edit_quest is rejected when the quest's updated_at differs from expected_updated_at.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "id", "ts", "kind", "source", "payload"],
  "properties": {
    "version": { "const": 1 },
    "id": { "$ref": "#/$defs/ulid" },
    "ts": { "type": "string", "format": "date-time" },
    "kind": {
      "enum": [
        "confirm",
        "seal",
        "return",
        "retry",
        "cancel",
        "archive",
        "summon",
        "wake",
        "suspend",
        "release",
        "reassign",
        "send_to_temple",
        "declare_campaign",
        "close_campaign",
        "create_quest",
        "answer",
        "set_rank",
        "attach_territory",
        "edit_quest",
        "pin_tag"
      ]
    },
    "source": { "enum": ["cli", "herald", "lite"] },
    "payload": { "type": "object" }
  },
  "allOf": [
    { "if": { "properties": { "kind": { "const": "confirm" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/p_quest" } } } },
    { "if": { "properties": { "kind": { "const": "seal" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/p_seal" } } } },
    { "if": { "properties": { "kind": { "const": "return" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/p_return" } } } },
    { "if": { "properties": { "kind": { "const": "retry" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/p_quest" } } } },
    { "if": { "properties": { "kind": { "const": "cancel" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/p_quest_reason" } } } },
    { "if": { "properties": { "kind": { "const": "archive" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/p_quest_reason" } } } },
    { "if": { "properties": { "kind": { "const": "summon" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/p_character" } } } },
    { "if": { "properties": { "kind": { "const": "wake" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/p_wake" } } } },
    { "if": { "properties": { "kind": { "const": "suspend" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/p_character_reason" } } } },
    { "if": { "properties": { "kind": { "const": "release" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/p_character" } } } },
    { "if": { "properties": { "kind": { "const": "reassign" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/p_reassign" } } } },
    { "if": { "properties": { "kind": { "const": "send_to_temple" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/p_character" } } } },
    { "if": { "properties": { "kind": { "const": "declare_campaign" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/p_declare_campaign" } } } },
    { "if": { "properties": { "kind": { "const": "close_campaign" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/p_close_campaign" } } } },
    { "if": { "properties": { "kind": { "const": "create_quest" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/p_create_quest" } } } },
    { "if": { "properties": { "kind": { "const": "answer" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/p_answer" } } } },
    { "if": { "properties": { "kind": { "const": "set_rank" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/p_set_rank" } } } },
    { "if": { "properties": { "kind": { "const": "attach_territory" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/p_attach_territory" } } } },
    { "if": { "properties": { "kind": { "const": "edit_quest" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/p_edit_quest" } } } },
    { "if": { "properties": { "kind": { "const": "pin_tag" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/p_pin_tag" } } } }
  ],
  "$defs": {
    "ulid": { "type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$" },
    "quest_id": { "type": "string", "pattern": "^q_[0-9]{8}_[0-9a-hjkmnp-tv-z]{6}$" },
    "campaign_id": { "type": "string", "pattern": "^c_[0-9]{8}_[0-9a-hjkmnp-tv-z]{6}$" },
    "slug": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,30}[a-z0-9])?$" },
    "registry_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "rank": { "enum": ["F", "E", "D", "C", "B", "A", "S"] },
    "p_quest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["quest"],
      "properties": { "quest": { "$ref": "#/$defs/quest_id" } }
    },
    "p_quest_reason": {
      "type": "object",
      "additionalProperties": false,
      "required": ["quest"],
      "properties": {
        "quest": { "$ref": "#/$defs/quest_id" },
        "reason": { "type": "string" }
      }
    },
    "p_seal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["quest"],
      "properties": {
        "quest": { "$ref": "#/$defs/quest_id" },
        "note": { "type": "string" }
      }
    },
    "p_return": {
      "type": "object",
      "additionalProperties": false,
      "required": ["quest", "notes"],
      "description": "Return always carries a note (design: the Return button requires one).",
      "properties": {
        "quest": { "$ref": "#/$defs/quest_id" },
        "notes": { "type": "string", "minLength": 1 }
      }
    },
    "p_character": {
      "type": "object",
      "additionalProperties": false,
      "required": ["character"],
      "properties": { "character": { "$ref": "#/$defs/slug" } }
    },
    "p_character_reason": {
      "type": "object",
      "additionalProperties": false,
      "required": ["character"],
      "properties": {
        "character": { "$ref": "#/$defs/slug" },
        "reason": { "type": "string" }
      }
    },
    "p_wake": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tribe"],
      "description": "'I signed in again': probe this tribe now.",
      "properties": { "tribe": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" } }
    },
    "p_reassign": {
      "type": "object",
      "additionalProperties": false,
      "required": ["quest"],
      "description": "Without character, the Steward selects the next eligible character.",
      "properties": {
        "quest": { "$ref": "#/$defs/quest_id" },
        "character": { "$ref": "#/$defs/slug" }
      }
    },
    "p_declare_campaign": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "mode"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 60 },
        "mode": { "enum": ["offense", "defense"] },
        "deadline": { "type": "string", "format": "date-time" }
      }
    },
    "p_close_campaign": {
      "type": "object",
      "additionalProperties": false,
      "required": ["campaign", "outcome"],
      "properties": {
        "campaign": { "$ref": "#/$defs/campaign_id" },
        "outcome": { "enum": ["won", "lost"] }
      }
    },
    "p_create_quest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["draft", "title", "description", "kind", "rank", "territory", "created_by"],
      "description": "draft = true when it comes from the Chancellor (quest starts in `draft`, needs confirm); false for `elvaria quest add` (starts `open`). The Steward writes the quest file.",
      "properties": {
        "draft": { "type": "boolean" },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "description": { "type": "string", "minLength": 1 },
        "kind": { "$ref": "#/$defs/registry_id" },
        "rank": { "$ref": "#/$defs/rank" },
        "territory": { "$ref": "#/$defs/slug" },
        "tier": { "enum": ["script", "session"], "default": "session" },
        "script": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id"],
          "properties": {
            "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
            "params": { "type": "object", "default": {} }
          }
        },
        "class_required": { "$ref": "#/$defs/registry_id", "description": "Required for tier = session." },
        "tags": { "type": "array", "items": { "$ref": "#/$defs/registry_id" }, "uniqueItems": true, "maxItems": 6, "default": [] },
        "party_role": { "const": "contract", "description": "Set when this plan quest forms a party (product plan 0.5 §6). Parts come later from the party lead's output, the merge quest from the Steward; neither goes through the inbox." },
        "estimate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tokens", "minutes"],
          "properties": {
            "tokens": { "type": "integer", "minimum": 0 },
            "minutes": { "type": "integer", "minimum": 0 }
          }
        },
        "seal_required": { "type": "boolean" },
        "secrets_required": { "type": "array", "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }, "uniqueItems": true },
        "depends_on": { "type": "array", "items": { "$ref": "#/$defs/quest_id" }, "uniqueItems": true },
        "campaign_id": { "$ref": "#/$defs/campaign_id" },
        "parent_id": { "$ref": "#/$defs/quest_id" },
        "question": { "type": "string", "minLength": 1, "maxLength": 300, "description": "The Chancellor's one follow-up question; the draft is created with blocked.question." },
        "created_by": { "enum": ["chancellor", "user", "council", "patrol", "battle", "campaign"] }
      },
      "allOf": [
        { "if": { "properties": { "tier": { "const": "script" } }, "required": ["tier"] }, "then": { "required": ["script"] } },
        { "if": { "not": { "properties": { "tier": { "const": "script" } }, "required": ["tier"] } }, "then": { "required": ["class_required"] } }
      ]
    },
    "p_pin_tag": {
      "type": "object",
      "additionalProperties": false,
      "required": ["character", "tag"],
      "description": "Pin a character to an expertise tag (it ranks first and gives the title); tag = null removes the pin.",
      "properties": {
        "character": { "$ref": "#/$defs/slug" },
        "tag": { "type": ["string", "null"], "pattern": "^[a-z][a-z0-9_]*$" }
      }
    },
    "p_answer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["quest", "answer"],
      "description": "Answer to blocked.question; written into handover.md.",
      "properties": {
        "quest": { "$ref": "#/$defs/quest_id" },
        "answer": { "type": "string", "minLength": 1 }
      }
    },
    "p_set_rank": {
      "type": "object",
      "additionalProperties": false,
      "required": ["quest", "rank"],
      "properties": {
        "quest": { "$ref": "#/$defs/quest_id" },
        "rank": { "$ref": "#/$defs/rank" }
      }
    },
    "p_attach_territory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": { "type": "string", "pattern": "^(?:[A-Za-z]:/|/)[^\\\\]*$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 24 },
        "id": { "$ref": "#/$defs/slug" }
      }
    },
    "p_edit_quest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["quest", "expected_updated_at", "changes"],
      "properties": {
        "quest": { "$ref": "#/$defs/quest_id" },
        "expected_updated_at": { "type": "string", "format": "date-time" },
        "changes": {
          "type": "object",
          "additionalProperties": false,
          "anyOf": [
            { "required": ["title"] },
            { "required": ["description"] },
            { "required": ["rank"] },
            { "required": ["seal_required"] },
            { "required": ["depends_on"] },
            { "required": ["budget"] }
          ],
          "properties": {
            "title": { "type": "string", "minLength": 1, "maxLength": 120 },
            "description": { "type": "string", "minLength": 1 },
            "rank": { "$ref": "#/$defs/rank" },
            "seal_required": { "type": "boolean" },
            "depends_on": { "type": "array", "items": { "$ref": "#/$defs/quest_id" }, "uniqueItems": true },
            "budget": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "max_minutes": { "type": "integer", "minimum": 1 },
                "max_tokens": { "type": "integer", "minimum": 0 },
                "max_attempts": { "type": "integer", "minimum": 1 }
              }
            }
          }
        }
      }
    }
  },
  "examples": [
    {
      "version": 1,
      "id": "01JCFB7Q2R8S4T6V9W3X5Y1Z0A",
      "ts": "2026-11-06T19:45:00+07:00",
      "kind": "seal",
      "source": "lite",
      "payload": { "quest": "q_20261106_7k3m2a", "note": "Đã xem diff trên điện thoại." }
    },
    {
      "version": 1,
      "id": "01JCFC3D5E7F9G1H3J5K7M9N2P",
      "ts": "2026-11-06T09:20:00+07:00",
      "kind": "create_quest",
      "source": "cli",
      "payload": {
        "draft": true,
        "title": "Kiểm tra link nội bộ",
        "description": "Kiểm tra mọi link nội bộ trong README.md, docs/**/*.md và CLAUDE.md.",
        "kind": "batch",
        "rank": "E",
        "territory": "dc1-se-team",
        "tier": "script",
        "script": { "id": "link-check", "params": { "globs": ["README.md", "docs/**/*.md", "CLAUDE.md"] } },
        "tags": ["docs"],
        "estimate": { "tokens": 0, "minutes": 2 },
        "seal_required": false,
        "created_by": "chancellor"
      }
    },
    {
      "version": 1,
      "id": "01JCFD8E2F4G6H8J0K2M4N6P8Q",
      "ts": "2026-11-06T20:05:00+07:00",
      "kind": "return",
      "source": "herald",
      "payload": { "quest": "q_20261106_7k3m2a", "notes": "README vẫn ghi lệnh cũ ở mục kiểm tra trước khi push; sửa rồi nộp lại." }
    },
    {
      "version": 1,
      "id": "01JCFE1F3G5H7J9K1M3N5P7Q9R",
      "ts": "2026-11-07T07:50:00+07:00",
      "kind": "pin_tag",
      "source": "herald",
      "payload": { "character": "thorn", "tag": "frontend" }
    }
  ]
}
