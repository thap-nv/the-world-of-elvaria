    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "id",
        "ts",
        "kind",
        "source",
        "payload"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "id": {
          "type": "string",
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "ts": {
          "type": "string",
          "format": "date-time"
        },
        "kind": {
          "const": "create_quest"
        },
        "source": {
          "enum": [
            "cli",
            "herald",
            "lite"
          ]
        },
        "payload": {
          "description": "draft = true when it comes from the Chancellor (quest starts in `draft`, needs confirm); false for `elvaria quest add` (starts `open`). The Steward writes the quest file.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "draft",
            "title",
            "description",
            "kind",
            "rank",
            "territory",
            "created_by"
          ],
          "properties": {
            "draft": {
              "type": "boolean"
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "description": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "rank": {
              "$ref": "#/$defs/rank"
            },
            "territory": {
              "type": "string",
              "pattern": "^[a-z0-9](?:[a-z0-9-]{0,30}[a-z0-9])?$",
              "not": {
                "enum": [
                  "global"
                ]
              }
            },
            "tier": {
              "enum": [
                "script",
                "session"
              ],
              "default": "session"
            },
            "script": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]*$"
                },
                "params": {
                  "type": "object",
                  "default": {}
                }
              }
            },
            "class_required": {
              "description": "Required for tier = session.",
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "tags": {
              "type": "array",
              "maxItems": 6,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "default": []
            },
            "party_role": {
              "description": "Set when this plan quest forms a party (product plan 0.5 §6). Parts come later from the party lead's output, the merge quest from the Steward; neither goes through the inbox.",
              "const": "contract"
            },
            "estimate": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "tokens",
                "minutes"
              ],
              "properties": {
                "tokens": {
                  "type": "integer",
                  "minimum": 0
                },
                "minutes": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "seal_required": {
              "type": "boolean"
            },
            "secrets_required": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              }
            },
            "depends_on": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^q_[0-9]{8}_[0-9a-hjkmnp-tv-z]{6}$"
              }
            },
            "campaign_id": {
              "type": "string",
              "pattern": "^c_[0-9]{8}_[0-9a-hjkmnp-tv-z]{6}$"
            },
            "parent_id": {
              "type": "string",
              "pattern": "^q_[0-9]{8}_[0-9a-hjkmnp-tv-z]{6}$"
            },
            "question": {
              "description": "The Chancellor's one follow-up question; the draft is created with blocked.question.",
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            },
            "created_by": {
              "enum": [
                "chancellor",
                "user",
                "council",
                "patrol",
                "battle",
                "campaign"
              ]
            },
            "assignee": {
              "description": "The character the owner gives the quest to (`elvaria quest add --to`, P1-29): only it takes the quest, as after a reassign naming it; its level aside, a rank above its ceiling makes the quest wait for the royal seal. Only for a session-tier quest created open (draft = false). The Steward refuses the command, creating no quest, when the character is unknown, of another class, suspended or of a disabled tribe.",
              "type": "string",
              "pattern": "^[a-z0-9](?:[a-z0-9-]{0,30}[a-z0-9])?$",
              "not": {
                "enum": [
                  "user",
                  "machine",
                  "temple"
                ]
              }
            }
          },
          "allOf": [
            {
              "if": {
                "required": [
                  "tier"
                ],
                "properties": {
                  "tier": {
                    "const": "script"
                  }
                }
              },
              "then": {
                "required": [
                  "script"
                ]
              }
            },
            {
              "if": {
                "not": {
                  "required": [
                    "tier"
                  ],
                  "properties": {
                    "tier": {
                      "const": "script"
                    }
                  }
                }
              },
              "then": {
                "required": [
                  "class_required"
                ]
              }
            },
            {
              "if": {
                "required": [
                  "assignee"
                ]
              },
              "then": {
                "not": {
                  "required": [
                    "tier"
                  ],
                  "properties": {
                    "tier": {
                      "const": "script"
                    }
                  }
                },
                "properties": {
                  "draft": {
                    "const": false
                  }
                }
              }
            }
          ]
        }
      }
    },
    {
