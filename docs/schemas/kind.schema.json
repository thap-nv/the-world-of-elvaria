{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elvaria.dev/schemas/kind/v1",
  "title": "Registry: quest kinds",
  "description": "registry/kinds.json in the kingdom (copied from @elvaria/registry-default on init; the owner may edit it). Every real job falls into one of these kinds; each kind names its verification ritual, default machine checks, deliverable convention and which classes may take it. Adding a kind = adding an entry here plus rituals.json and theme data; the domain has no switch over kinds (ADR 0016). The campaign (war) is a container entity, not a kind.",
  "$comment": "Hand-written v1, the reviewed target; from P0-03 generated by `pnpm schemas` from zod (ADR 0003). Cross-file checks done by the registry loader: ids unique; ritual exists in rituals.json; every classes_allowed entry exists in classes.json. Display names in the UI come from i18n; name_vi/name_en here are the registry's own labels for the CLI and docs.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "kinds"],
  "properties": {
    "version": { "const": 1 },
    "kinds": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/kind" } }
  },
  "$defs": {
    "registry_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "kind": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name_vi", "name_en", "deliverable_type", "ritual", "checks_default", "seal_default", "classes_allowed"],
      "properties": {
        "id": { "$ref": "#/$defs/registry_id" },
        "name_vi": { "type": "string", "minLength": 1 },
        "name_en": { "type": "string", "minLength": 1 },
        "deliverable_type": { "enum": ["branch", "file", "report", "draft", "subquests", "none"] },
        "ritual": { "$ref": "#/$defs/registry_id" },
        "checks_default": {
          "type": "array",
          "items": { "$ref": "#/$defs/registry_id" },
          "description": "Check categories the ritual expects; matched to territory check ids where they exist."
        },
        "seal_default": { "type": "boolean", "description": "Default for quest.seal_required." },
        "classes_allowed": { "type": "array", "items": { "$ref": "#/$defs/registry_id" }, "uniqueItems": true }
      }
    }
  },
  "examples": [
    {
      "version": 1,
      "kinds": [
        { "id": "build", "name_vi": "Kiến tạo", "name_en": "Build", "deliverable_type": "branch", "ritual": "build_review", "checks_default": ["test", "lint", "typecheck", "build"], "seal_default": true, "classes_allowed": ["knight", "dwarf"] },
        { "id": "research", "name_vi": "Thám hiểm", "name_en": "Research", "deliverable_type": "report", "ritual": "source_check", "checks_default": ["links_alive", "citations"], "seal_default": false, "classes_allowed": ["scout"] },
        { "id": "fix", "name_vi": "Trừ tà", "name_en": "Fix", "deliverable_type": "branch", "ritual": "regression_check", "checks_default": ["regression_test", "test"], "seal_default": true, "classes_allowed": ["knight", "dwarf"] },
        { "id": "refactor", "name_vi": "Gia cố", "name_en": "Refactor", "deliverable_type": "branch", "ritual": "stress_test", "checks_default": ["benchmark", "test", "diff_stats"], "seal_default": true, "classes_allowed": ["knight", "dwarf"] },
        { "id": "document", "name_vi": "Soạn thảo", "name_en": "Document", "deliverable_type": "file", "ritual": "editorial_review", "checks_default": ["links_alive", "toc", "terminology"], "seal_default": true, "classes_allowed": ["scribe"] },
        { "id": "publish", "name_vi": "Rao truyền", "name_en": "Publish", "deliverable_type": "draft", "ritual": "audience_review", "checks_default": ["length", "banned_words", "utm_links"], "seal_default": true, "classes_allowed": ["bard"] },
        { "id": "analyze", "name_vi": "Chiêm nghiệm", "name_en": "Analyze", "deliverable_type": "report", "ritual": "recompute", "checks_default": ["rerun_script", "numbers_match"], "seal_default": false, "classes_allowed": ["astrologer"] },
        { "id": "plan", "name_vi": "Nghị hội", "name_en": "Plan", "deliverable_type": "subquests", "ritual": "council_review", "checks_default": ["subquests_complete"], "seal_default": false, "classes_allowed": ["mage"] },
        { "id": "integrate", "name_vi": "Chinh phục", "name_en": "Integrate", "deliverable_type": "branch", "ritual": "stability_check", "checks_default": ["stable_days", "docs_present", "owner_named", "legacy_removed"], "seal_default": true, "classes_allowed": ["dwarf", "knight"] },
        { "id": "negotiate", "name_vi": "Ngoại giao", "name_en": "Negotiate", "deliverable_type": "draft", "ritual": "sign_off", "checks_default": [], "seal_default": true, "classes_allowed": ["envoy"] },
        { "id": "batch", "name_vi": "Trận đánh", "name_en": "Batch", "deliverable_type": "report", "ritual": "unit_tally", "checks_default": ["per_unit"], "seal_default": false, "classes_allowed": ["knight", "scout", "dwarf"] }
      ]
    }
  ]
}
