{
  "name": "the-world-of-elvaria",
  "private": true,
  "description": "Elvaria: a low-poly fantasy world where each AI agent is a character doing real work on your repos.",
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm boundaries && pnpm schemas --check && pnpm docs:gen --check && pnpm docs:check && pnpm i18n:check",
    "check:fast": "pnpm typecheck && pnpm test && pnpm boundaries",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json && pnpm -r --if-present typecheck",
    "test": "vitest run && pnpm -r --if-present test",
    "boundaries": "depcruise \"{packages,apps}/*\" --config .dependency-cruiser.mjs",
    "schemas": "node scripts/gen-schemas.mjs",
    "docs:gen": "node scripts/docs-gen.mjs",
    "docs:check": "node scripts/docs-check.mjs",
    "i18n:check": "node scripts/i18n-check.mjs",
    "elvaria": "node scripts/not-yet.mjs P0-08",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs,js}": [
      "eslint --fix --max-warnings=0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write --ignore-unknown"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@elvaria/config": "workspace:*",
    "@elvaria/domain": "workspace:*",
    "@elvaria/i18n": "workspace:*",
    "@types/node": "^24.19.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "dependency-cruiser": "^18.7.2",
    "eslint": "^10.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0"
  }
}
