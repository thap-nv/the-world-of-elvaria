{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": true,
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs!", ".claude/hooks/*.mjs!", "*.config.mjs"],
      "project": ["scripts/**/*.mjs!", "scripts/**/*.ts", ".claude/hooks/**/*.mjs!", ".claude/hooks/**/*.ts"]
    },
    "apps/cli": {
      "entry": ["src/cli.ts!", "src/bell/show-toast.ts!", "fixtures/*.mjs"],
      "project": ["src/**/*.ts!", "!src/**/*.spec.ts!", "!src/**/__fixtures__/**!", "fixtures/**/*.mjs"]
    },
    "packages/config": {
      "entry": ["*.mjs!"],
      "project": ["*.mjs!", "*.ts"]
    },
    "packages/hooks": {
      "entry": ["src/elvaria-hook.ts!", "src/__fixtures__/*.mjs"],
      "project": ["src/**/*.ts!", "!src/**/*.spec.ts!", "!src/**/__fixtures__/**!", "src/**/*.mjs"]
    },
    "packages/registry-default": {
      "entry": ["scripts/**/*.mjs!"],
      "project": ["src/**/*.ts!", "!src/**/*.spec.ts!", "scripts/**/*.mjs!"]
    },
    "packages/runner-*": {
      "entry": ["fixtures/*.mjs"],
      "project": ["src/**/*.ts!", "!src/**/*.spec.ts!", "!src/**/__fixtures__/**!", "fixtures/**/*.mjs"]
    },
    "packages/*": {
      "project": ["src/**/*.ts!", "!src/**/*.spec.ts!", "!src/**/__fixtures__/**!"]
    }
  }
}
